@page "/map"
@inject MapViewModel VM
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AviatesAirTracker.Services.SimBriefService SimBriefSvc
@inject AviatesAirTracker.Services.SettingsService Settings
@inject AviatesAirTracker.Services.FlightSessionManager Session
@inject AviatesAirTracker.Services.OtherPilotsService OtherPilots
@inject AviatesAirTracker.Services.MessagingService Messaging
@implements IAsyncDisposable
@using AviatesAirTracker.Models
@using System.Linq
@using Serilog

<div class="map-page">

    <div id="leaflet-map"></div>

    @* ── Top-left: Flight identity + Telemetry ── *@
    <div class="hud hud--tl" id="hud-identity">
        <div class="hud-drag" data-drag-handle title="Drag to move"></div>
        <div class="hud-route-row">
            <span class="hud-route">@VM.RouteLabel</span>
            <span class="hud-phase"
                  style="background:@(VM.PhaseColor)22;border-color:@(VM.PhaseColor)66;color:@VM.PhaseColor;">
                @VM.PhaseText
            </span>
        </div>
        <div class="hud-divider"></div>
        <div class="hud-grid">
            <span class="hud-label">ALT</span>  <span class="hud-val">@VM.AltText</span>
            <span class="hud-label">VS</span>   <span class="hud-val">@VM.VsText</span>
            <span class="hud-label">IAS</span>  <span class="hud-val">@VM.IasText</span>
            <span class="hud-label">GS</span>   <span class="hud-val">@VM.GsText</span>
            <span class="hud-label">HDG</span>  <span class="hud-val">@VM.HdgText</span>
            <span class="hud-label">MACH</span> <span class="hud-val">@VM.MachText</span>
        </div>
    </div>

    @* ── Bottom-left: Progress ── *@
    <div class="hud hud--bl" id="hud-progress">
        <div class="hud-drag" data-drag-handle title="Drag to move"></div>
        <div class="hud-row">
            <span class="hud-label">NEXT</span>
            <span class="hud-val hud-val--accent">@VM.NextWaypoint</span>
            <span class="hud-label hud-label--ml">ETA</span>
            <span class="hud-val hud-val--accent">@VM.EtaZ</span>
        </div>
        <div class="hud-divider"></div>
        <div class="hud-row">
            <span class="hud-label">DIST REM</span>
            <span class="hud-val">@VM.DistRemText</span>
            <span class="hud-label hud-label--ml">FUEL</span>
            <span class="hud-val">@VM.FuelRemText</span>
        </div>
    </div>

    @* ── Bottom-right: Map controls ── *@
    <div class="hud hud--br hud--controls" id="hud-controls">
        <button class="map-ctrl-btn" title="Centre on aircraft" @onclick="CentreOnAircraftAsync">✈</button>
        <button class="map-ctrl-btn" title="Zoom in"           @onclick="ZoomInAsync">+</button>
        <button class="map-ctrl-btn" title="Zoom out"          @onclick="ZoomOutAsync">−</button>
    </div>

    @* ── Other-pilot details panel ── *@
    @if (_selectedPilot is not null)
    {
        <div class="hud hud--pilot-detail" id="hud-pilot-detail">
            <div class="hud-drag" data-drag-handle title="Drag to move"></div>
            <div class="hud-route-row">
                <span class="hud-route">@_selectedPilot.PilotName</span>
                <span class="hud-phase" style="background:#3D7EEE22;border-color:#3D7EEE66;color:#3D7EEE;">
                    @_selectedPilot.Phase.ToUpper()
                </span>
                <button class="hud-close-btn" title="Close" @onclick="() => _selectedPilot = null">×</button>
            </div>
            <div class="hud-divider"></div>
            <div class="hud-grid">
                <span class="hud-label">ALT</span>  <span class="hud-val">@_selectedPilot.Alt ft</span>
                <span class="hud-label">GS</span>   <span class="hud-val">@_selectedPilot.Speed kts</span>
                <span class="hud-label">HDG</span>  <span class="hud-val">@_selectedPilot.Heading°</span>
            </div>
            @if (!string.IsNullOrEmpty(_selectedPilot.DepartureIcao) || !string.IsNullOrEmpty(_selectedPilot.ArrivalIcao))
            {
                <div class="hud-divider"></div>
                <span class="hud-label">@(_selectedPilot.DepartureIcao ?? "----") → @(_selectedPilot.ArrivalIcao ?? "----")</span>
            }
            <div class="hud-divider"></div>
            <button class="map-ctrl-btn hud-plan-btn" @onclick="() => MessageSelectedPilotAsync()">MESSAGE</button>
        </div>
    }

    @* ── Top-right: SimBrief plan ── *@
    <div class="hud hud--tr" id="hud-plan">
        <div class="hud-drag" data-drag-handle title="Drag to move"></div>

        @if (_planLoading)
        {
            <div class="hud-plan-loading">
                <div class="hud-plan-spinner"></div>
                <span class="hud-label">FETCHING OFP…</span>
            </div>
        }
        else if (_currentPlan is not null)
        {
            <div class="hud-route-row">
                <span class="hud-route">@_currentPlan.DepartureICAO → @_currentPlan.ArrivalICAO</span>
            </div>
            <div class="hud-divider"></div>
            <span class="hud-label">@_currentPlan.AircraftType &nbsp;·&nbsp; @_currentPlan.Waypoints.Count WPT</span>
            <div class="hud-divider"></div>
            <button class="map-ctrl-btn hud-plan-btn" @onclick="ImportSimBriefAsync">REFRESH OFP</button>
        }
        else
        {
            @if (_planError is not null)
            {
                <div class="hud-plan-error">@_planError</div>
                <div class="hud-divider"></div>
            }

            @if (string.IsNullOrWhiteSpace(Settings.Settings.SimBriefUsername))
            {
                <span class="hud-label">NO SIMBRIEF ID</span>
                <div class="hud-divider"></div>
                <a href="/settings" class="map-ctrl-btn hud-plan-btn" style="text-decoration:none;">CONFIGURE</a>
            }
            else
            {
                <span class="hud-label">NO FLIGHT PLAN</span>
                <div class="hud-divider"></div>
                <button class="map-ctrl-btn hud-plan-btn" @onclick="ImportSimBriefAsync">IMPORT OFP</button>
            }
        }
    </div>

    @if (!VM.HasActiveFlight)
    {
        <div class="map-no-flight">@VM.NoFlightText</div>
    }

</div>

@code {
    private bool _mapInitialized;
    private bool                _planLoading;
    private string?             _planError;
    private SimBriefFlightPlan? _currentPlan;
    private LivePilotPosition?  _selectedPilot;
    private DotNetObjectReference<MapPage>? _dotNetRef;
    private HashSet<string> _renderedOtherPilotIds = new();

    protected override void OnInitialized()
    {
        VM.MapRenderRequested += OnMapRenderRequested;
        SimBriefSvc.FlightPlanLoaded += OnFlightPlanLoaded;
        OtherPilots.PositionsUpdated += OnOtherPilotsUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JS.InvokeVoidAsync("aviatesMap.init", VM.Lat, VM.Lon);
        await JS.InvokeVoidAsync("aviatesTokDrag.initDrag", "hud-identity");
        await JS.InvokeVoidAsync("aviatesTokDrag.initDrag", "hud-progress");
        await JS.InvokeVoidAsync("aviatesTokDrag.initDrag", "hud-plan");

        _mapInitialized = true;
        VM.MapReady     = true;

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("aviatesMap.setOtherPilotClickHandler", _dotNetRef);
        await RenderOtherPilotsAsync(OtherPilots.LatestPositions);

        // Push any SimBrief plan that was already loaded before this page was opened
        var (plan, _) = VM.ConsumePlanSync();
        if (plan is not null)
            await PushPlannedRouteAsync(plan);

        _currentPlan = SimBriefSvc.CurrentPlan;
        if (_currentPlan is not null)
            StateHasChanged();
    }

    // Fired from OtherPilotsService's background Timer thread — must marshal onto the
    // render sync context via InvokeAsync before touching JS interop or component state
    // (see CLAUDE.md's threading notes on cross-thread updates from background pumps).
    private void OnOtherPilotsUpdated(object? sender, List<LivePilotPosition> positions)
    {
        _ = InvokeAsync(async () =>
        {
            await RenderOtherPilotsAsync(positions);
            StateHasChanged();
        });
    }

    private async Task RenderOtherPilotsAsync(List<LivePilotPosition> positions)
    {
        if (!_mapInitialized) return;

        var currentIds = positions.Select(p => p.PilotId).ToHashSet();

        foreach (var stalePilotId in _renderedOtherPilotIds.Except(currentIds).ToList())
        {
            await JS.InvokeVoidAsync("aviatesMap.removeOtherPilot", stalePilotId);
        }

        foreach (var pos in positions)
        {
            var waypointJs = pos.Waypoints?.Select(w => new { lat = w.Lat, lon = w.Lon }).ToArray();
            await JS.InvokeVoidAsync("aviatesMap.upsertOtherPilot",
                pos.PilotId, pos.Lat, pos.Lon, (object?)waypointJs);
        }

        _renderedOtherPilotIds = currentIds;

        if (_selectedPilot is not null)
            _selectedPilot = positions.FirstOrDefault(p => p.PilotId == _selectedPilot.PilotId);
    }

    [JSInvokable]
    public void OnOtherPilotClicked(string pilotId)
    {
        _selectedPilot = OtherPilots.LatestPositions.FirstOrDefault(p => p.PilotId == pilotId);
        StateHasChanged();
    }

    private async Task MessageSelectedPilotAsync()
    {
        if (_selectedPilot is null) return;
        await Messaging.AddOrGetFriendFromLiveMapAsync(_selectedPilot.PilotId, _selectedPilot.PilotName);
        Nav.NavigateTo($"/messages?open={Uri.EscapeDataString(_selectedPilot.PilotId)}");
    }

    private void OnMapRenderRequested()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await PushMapToJSAsync();
                StateHasChanged();
            }
            catch (JSException ex)
            {
                Log.Warning(ex, "Map JS render update failed");
            }
        });
    }

    private void OnFlightPlanLoaded(object? sender, SimBriefFlightPlan plan)
    {
        _ = InvokeAsync(() =>
        {
            _currentPlan = plan;
            _planError   = null;
            StateHasChanged();
        });
    }

    private async Task PushMapToJSAsync()
    {
        if (!_mapInitialized) return;

        await JS.InvokeVoidAsync("aviatesMap.updatePosition", VM.Lat, VM.Lon, VM.Hdg);

        var pts = VM.GetPathIfChanged();
        if (pts is not null)
            await JS.InvokeVoidAsync("aviatesMap.updateFlightPathAltitude", pts);

        var (plan, dirty) = VM.ConsumePlanSync();
        if (dirty && plan is not null)
            await PushPlannedRouteAsync(plan);
    }

    private async Task PushPlannedRouteAsync(SimBriefFlightPlan plan)
    {
        var waypointJs = plan.Waypoints
            .Where(w => (w.Latitude != 0 || w.Longitude != 0)
                     && Math.Abs(w.Latitude)  <= 90
                     && Math.Abs(w.Longitude) <= 180)
            .Select(w => new { lat = w.Latitude, lon = w.Longitude, type = w.Type, id = w.Identifier })
            .ToArray();

        await JS.InvokeVoidAsync("aviatesMap.clearAirportMarkers");
        await JS.InvokeVoidAsync("aviatesMap.setPlannedRoute", (object)waypointJs);

        if (plan.DepartureLat != 0 || plan.DepartureLon != 0)
            await JS.InvokeVoidAsync("aviatesMap.addAirportMarker",
                plan.DepartureLat, plan.DepartureLon, plan.DepartureICAO, "dep");

        if (plan.ArrivalLat != 0 || plan.ArrivalLon != 0)
            await JS.InvokeVoidAsync("aviatesMap.addAirportMarker",
                plan.ArrivalLat, plan.ArrivalLon, plan.ArrivalICAO, "arr");

        if (!string.IsNullOrEmpty(plan.AlternateICAO) &&
            (plan.AlternateLat != 0 || plan.AlternateLon != 0))
            await JS.InvokeVoidAsync("aviatesMap.addAirportMarker",
                plan.AlternateLat, plan.AlternateLon, plan.AlternateICAO, "alt");

        await JS.InvokeVoidAsync("aviatesMap.fitRouteBounds");
    }

    private async Task ImportSimBriefAsync()
    {
        var username = Settings.Settings.SimBriefUsername;
        if (string.IsNullOrWhiteSpace(username)) return;

        _planLoading = true;
        _planError   = null;
        StateHasChanged();

        try
        {
            var plan = await SimBriefSvc.FetchLatestOFPAsync(username);
            if (plan is not null)
            {
                _currentPlan = plan;
                Session.AssignSimBriefPlan(plan);
                SimBriefSvc.NotifyPlanLoaded(plan);
            }
            else
            {
                _planError = "NO OFP FOUND";
            }
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "SimBrief OFP fetch failed");
            _planError = "FETCH FAILED";
        }
        finally
        {
            _planLoading = false;
            StateHasChanged();
        }
    }

    private Task CentreOnAircraftAsync() =>
        JS.InvokeVoidAsync("aviatesMap.panTo", VM.Lat, VM.Lon).AsTask();

    private Task ZoomInAsync() =>
        JS.InvokeVoidAsync("aviatesMap.zoomIn").AsTask();

    private Task ZoomOutAsync() =>
        JS.InvokeVoidAsync("aviatesMap.zoomOut").AsTask();

    public async ValueTask DisposeAsync()
    {
        VM.MapRenderRequested -= OnMapRenderRequested;
        SimBriefSvc.FlightPlanLoaded -= OnFlightPlanLoaded;
        OtherPilots.PositionsUpdated -= OnOtherPilotsUpdated;
        VM.MapReady     = false;
        _mapInitialized = false;
        _dotNetRef?.Dispose();
        try { await JS.InvokeVoidAsync("aviatesMap.destroy"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }
}

<style>
    /* ── Full-page container ─────────────────────────────── */
    .map-page {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }

    #leaflet-map {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    /* ── Shared HUD card ─────────────────────────────────── */
    .hud {
        position: absolute;
        z-index: 100;
        background: rgba(10, 13, 23, 0.88);
        border: 1px solid rgba(61, 126, 238, 0.25);
        border-radius: 6px;
        backdrop-filter: blur(8px);
        padding: 10px 13px;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 9px;
        letter-spacing: 0.06em;
        min-width: 160px;
        box-shadow: 0 4px 24px rgba(10, 13, 23, 0.6);
    }

    /* ── HUD positions ───────────────────────────────────── */
    .hud--tl { top: 12px; left: 12px; }
    .hud--bl { bottom: 12px; left: 12px; }
    .hud--br { bottom: 12px; right: 12px; min-width: unset; padding: 6px; }
    .hud--tr { top: 12px; right: 12px; min-width: 160px; }
    .hud--pilot-detail { top: 12px; right: 190px; min-width: 170px; }

    /* ── Drag handle strip ───────────────────────────────── */
    .hud-drag {
        height: 4px;
        margin: -4px -13px 8px;
        border-radius: 6px 6px 0 0;
        background: rgba(61, 126, 238, 0.15);
        cursor: grab;
    }
    .hud-drag:active { cursor: grabbing; }

    /* ── Typography ──────────────────────────────────────── */
    .hud-route-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }
    .hud-route {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 0.04em;
    }
    .hud-phase {
        font-size: 7px;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: 2px 6px;
        border-radius: 3px;
        border: 1px solid;
        white-space: nowrap;
    }
    .hud-divider {
        height: 1px;
        background: rgba(61, 126, 238, 0.15);
        margin: 6px 0;
    }
    .hud-grid {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr;
        gap: 2px 8px;
        align-items: baseline;
    }
    .hud-label {
        color: rgba(255, 255, 255, 0.38);
        font-size: 8px;
        letter-spacing: 0.08em;
        white-space: nowrap;
    }
    .hud-label--ml { margin-left: 12px; }
    .hud-val {
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }
    .hud-val--accent { color: #3D7EEE; }
    .hud-row {
        display: flex;
        align-items: baseline;
        gap: 6px;
        flex-wrap: nowrap;
    }

    /* ── Controls card ───────────────────────────────────── */
    .hud--controls {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .map-ctrl-btn {
        width: 28px;
        height: 28px;
        background: rgba(61, 126, 238, 0.08);
        border: 1px solid rgba(61, 126, 238, 0.25);
        border-radius: 5px;
        color: rgba(255, 255, 255, 0.65);
        font-size: 14px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, color 0.15s;
        font-family: inherit;
    }
    .map-ctrl-btn:hover {
        background: rgba(61, 126, 238, 0.22);
        color: #ffffff;
    }
    .map-ctrl-btn:active {
        background: rgba(61, 126, 238, 0.35);
    }
    .map-ctrl-btn:focus-visible {
        outline: 2px solid rgba(61, 126, 238, 0.7);
        outline-offset: 2px;
    }
    .hud-close-btn {
        margin-left: auto;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.4);
        font-size: 14px;
        cursor: pointer;
        line-height: 1;
        padding: 0 0 0 8px;
    }
    .hud-close-btn:hover { color: #ffffff; }

    /* ── Plan HUD inner elements ────────────────────── */
    .hud-plan-loading {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .hud-plan-spinner {
        width: 12px;
        height: 12px;
        border: 1.5px solid rgba(61, 126, 238, 0.3);
        border-top-color: #3D7EEE;
        border-radius: 50%;
        animation: hud-spin 0.8s linear infinite;
        flex-shrink: 0;
    }
    @@keyframes hud-spin { to { transform: rotate(360deg); } }
    .hud-plan-error {
        font-size: 8px;
        color: #F97316;
        letter-spacing: 0.06em;
    }
    /* Intentionally overrides map-ctrl-btn square dimensions for full-width HUD buttons */
    .hud-plan-btn {
        width: 100%;
        height: 22px;
        font-size: 9px;
        letter-spacing: 0.06em;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ── No-flight overlay ───────────────────────────────── */
    .map-no-flight {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        color: rgba(255, 255, 255, 0.22);
        text-transform: uppercase;
        pointer-events: none;
        z-index: 50;
    }

    /* ── Leaflet tooltip style ───────────────────────────── */
    :global(.avt-wp-tooltip) {
        background: rgba(10, 13, 23, 0.88) !important;
        border: 1px solid rgba(61, 126, 238, 0.3) !important;
        border-radius: 4px !important;
        color: rgba(255, 255, 255, 0.75) !important;
        font-family: 'JetBrains Mono', monospace !important;
        font-size: 9px !important;
        letter-spacing: 0.08em !important;
        padding: 3px 7px !important;
        box-shadow: none !important;
    }
    :global(.avt-wp-tooltip::before) { display: none !important; }
</style>
