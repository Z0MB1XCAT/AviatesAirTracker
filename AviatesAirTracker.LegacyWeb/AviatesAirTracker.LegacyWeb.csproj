<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    TRANSITIONAL. Holds the Blazor UI while pages migrate to native WinUI XAML one at a
    time. Deleted wholesale in the final migration phase — nothing new should be added
    here. It exists because the WinUI app project cannot use Microsoft.NET.Sdk.Razor.

    The reference runs library -> app, never the reverse: the Razor pages @inject app
    types, so the app reaches this assembly at runtime via ILegacyUiHost instead.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Silences RAZORSDK1004 for Hosting\_Host.cshtml, which moved here (from
      AviatesAirTracker\Hosting\) in Task 8 of the WinUI 3 migration, along with the
      property that used to silence the warning there. On SDK 10.0.111 the Razor source
      generator compiles the page with or without this property — generated output is
      byte-identical either way — so it is retained only because CI pins .NET SDK 8.0.x,
      where the legacy pre-source-generator path may still apply and cannot be tested here.

      TRANSITIONAL: removed wholesale with the rest of this library at the end of the
      WinUI 3 migration.
    -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AviatesAirTracker\AviatesAirTracker.csproj" />
  </ItemGroup>

  <!-- Put this assembly next to the app executable so Assembly.Load finds it.
       Runs after this project builds, which is after the app it references.

       NOTE on the destination path's "win-x64" segment: AviatesAirTracker.csproj sets
       <RuntimeIdentifier>win-x64</RuntimeIdentifier> with <SelfContained>true</SelfContained>,
       which makes the SDK append the RID to the app's own build output path (AppendRuntime
       IdentifierToOutputPath defaults to true for self-contained RID builds) — the app's
       real output is bin\$(Configuration)\$(TargetFramework)\win-x64\, not
       bin\$(Configuration)\$(TargetFramework)\. This library has no RuntimeIdentifier of its
       own, so that segment can't be read off a shared property; it is hard-coded here and
       must be kept in sync if AviatesAirTracker.csproj's RuntimeIdentifier ever changes.

       NOTE on the scoped-CSS glob: with <Platforms>x64</Platforms> set, MSBuild inserts a
       different "x64" segment into both this project's bin AND obj paths (bin\x64\Debug\...) —
       unrelated to the app's RID segment above. The Razor SDK (as pinned by CI's .NET SDK
       8.0.x) never copies the scoped-CSS bundle into bin at all for a class library — it only
       ever lands under obj\...\scopedcss\projectbundle\. So the bundle is picked up from
       $(BaseIntermediateOutputPath) (obj\), not $(TargetDir) (bin\), and the glob is recursive
       so it does not hard-code that x64 segment. -->
  <PropertyGroup>
    <_AppOutputDir>$(MSBuildThisFileDirectory)..\AviatesAirTracker\bin\$(Configuration)\$(TargetFramework)\win-x64\</_AppOutputDir>
  </PropertyGroup>
  <Target Name="CopyToAppOutput" AfterTargets="Build">
    <ItemGroup>
      <_LegacyWebOutput Include="$(TargetDir)$(AssemblyName).dll" />
      <_LegacyWebOutput Include="$(TargetDir)$(AssemblyName).pdb" />
      <_LegacyWebScopedCss Include="$(BaseIntermediateOutputPath)**\scopedcss\projectbundle\$(AssemblyName).bundle.scp.css" />
    </ItemGroup>
    <Copy SourceFiles="@(_LegacyWebOutput)"
          DestinationFolder="$(_AppOutputDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_LegacyWebScopedCss)"
          DestinationFolder="$(_AppOutputDir)wwwroot\"
          SkipUnchangedFiles="true"
          Condition="'@(_LegacyWebScopedCss)' != ''" />
  </Target>

</Project>
