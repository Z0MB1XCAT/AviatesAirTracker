@inject AviatesAirTracker.Services.FlightRecoveryService Recovery
@inject AviatesAirTracker.Services.FlightSessionManager Session

@if (!_dismissed && !Recovery.Handled && Recovery.Pending is { } f)
{
    <div class="frm-backdrop">
        <div class="frm-card">
            <div class="frm-title">Resume interrupted flight?</div>
            <p class="frm-body">
                A flight <strong>@f.DepartureICAO → @f.ArrivalICAO</strong>@(string.IsNullOrEmpty(f.FlightNumber) ? "" : $" ({f.FlightNumber})")
                was still in progress when the app last closed. Continue tracking it, or discard it?
            </p>
            <div class="frm-actions">
                <button class="frm-btn frm-btn-ghost" @onclick="Discard">Discard</button>
                <button class="frm-btn frm-btn-primary" @onclick="Continue">Continue tracking</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _dismissed;

    private void Continue()
    {
        if (Recovery.Pending is { } f)
        {
            Session.ResumeFlight(f);
            Recovery.Handled = true;
        }
        _dismissed = true;
    }

    private async Task Discard()
    {
        await Recovery.DiscardAsync();   // deletes the record, sets Handled
        _dismissed = true;
    }
}
