@inject AlertService AlertService
@inject ILandingRepository LandingRepo
@inject IFlightRepository FlightRepo
@using AviatesAirTracker.Core.Analytics
@using AviatesAirTracker.Core.Data
@using Serilog
@implements IDisposable

@if (_visible && _result != null && _report != null)
{
    <div class="lrm-backdrop @(_animOut ? "lrm-bg-out" : "lrm-bg-in")" @onclick="Dismiss">
        <div class="lrm-card @(_animOut ? "lrm-card-out" : "lrm-card-in")" @onclick:stopPropagation="true">

            @if (!string.IsNullOrEmpty(_report.AircraftImagePath))
            {
                <img src="@_report.AircraftImagePath" alt="" class="lrm-photo" aria-hidden="true" />
            }

            <!-- ── HEADER ── -->
            <div class="lrm-header" style="border-top-color: @_report.GradeColor">
                <div class="lrm-header-left">
                    <div class="lrm-report-chip">TOUCHDOWN REPORT</div>
                    <div class="lrm-airport-id">
                        @_report.AirportIcao
                        <span class="lrm-dot">·</span>
                        @_report.Runway
                    </div>
                    @if (!string.IsNullOrEmpty(_report.FlightNumber) || !string.IsNullOrEmpty(_report.Route))
                    {
                        <div class="lrm-sub">
                            @_report.FlightNumber
                            @if (!string.IsNullOrEmpty(_report.Route)) { <span class="lrm-dot">·</span> @_report.Route }
                            @if (!string.IsNullOrEmpty(_report.AircraftType)) { <span class="lrm-dot">·</span> @_report.AircraftType }
                        </div>
                    }
                </div>
                <div class="lrm-header-right">
                    <span class="lrm-zulu">@_result.Timestamp.ToUniversalTime().ToString("HH:mm")Z</span>
                    <button class="lrm-close-x" @onclick="Dismiss" title="Close">
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                            <path d="M4 4l10 10M14 4L4 14"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ── HERO: RING + GRADE ── -->
            <div class="lrm-hero">

                <!-- Score ring -->
                <div class="lrm-ring-wrap">
                    <svg viewBox="0 0 200 200" fill="none" class="lrm-ring-svg">
                        <!-- Background track -->
                        <circle class="ring-track" cx="100" cy="100" r="80"/>
                        <!-- Animated fill arc -->
                        <circle class="ring-fill"
                                cx="100" cy="100" r="80"
                                stroke="@_report.GradeColor"
                                style="stroke-dashoffset: @_ringOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"/>
                        <!-- Major tick marks (every 36°) -->
                        @for (int i = 0; i < 10; i++)
                        {
                            var ang = i * 36.0 - 90.0;
                            var rad = ang * Math.PI / 180.0;
                            var ox = (100 + 93.0 * Math.Cos(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var oy = (100 + 93.0 * Math.Sin(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var ix = (100 + 83.0 * Math.Cos(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var iy = (100 + 83.0 * Math.Sin(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            <line x1="@ox" y1="@oy" x2="@ix" y2="@iy" class="ring-tick-maj"/>
                        }
                        <!-- Minor tick marks (every 18°) -->
                        @for (int i = 0; i < 20; i++)
                        {
                            if (i % 2 == 0) continue; // skip positions occupied by major ticks
                            var ang = i * 18.0 - 90.0;
                            var rad = ang * Math.PI / 180.0;
                            var ox = (100 + 91.0 * Math.Cos(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var oy = (100 + 91.0 * Math.Sin(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var ix = (100 + 86.0 * Math.Cos(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var iy = (100 + 86.0 * Math.Sin(rad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            <line x1="@ox" y1="@oy" x2="@ix" y2="@iy" class="ring-tick-min"/>
                        }
                    </svg>
                    <div class="lrm-score-center">
                        <span class="lrm-score-num">@_report.Score</span>
                        <span class="lrm-score-denom">/100</span>
                    </div>
                </div>

                <!-- Grade + butter meter + quality flags -->
                <div class="lrm-grade-col">
                    <div class="lrm-grade-badge"
                         style="color: @_report.GradeColor;
                                background: @GradeBg;
                                border-color: @_report.GradeColor">
                        @_report.Grade
                    </div>

                    <!-- Butter meter — the fun headline -->
                    <div class="lrm-butter" style="border-color:@_report.ButterColor">
                        <div class="lrm-butter-rating" style="color:@_report.ButterColor">@_report.ButterRating</div>
                        <div class="lrm-butter-blurb">@_report.ButterBlurb</div>
                        <div class="lrm-butter-vs">
                            <span style="color:@_report.ButterColor">@_report.VerticalSpeedFpm.ToString("F0")</span> fpm touchdown
                        </div>
                    </div>

                    <div class="lrm-flags">
                        <div class="lrm-flag @(_report.StableApproach ? "flag-ok" : "flag-fail")">
                            <span class="flag-pip">@(_report.StableApproach ? "✓" : "✗")</span>
                            Stable Approach
                        </div>
                        <div class="lrm-flag @(_report.FlareDetected ? "flag-ok" : "flag-neutral")">
                            <span class="flag-pip">@(_report.FlareDetected ? "✓" : "–")</span>
                            Flare Detected
                        </div>
                        @if (_report.BounceCount > 0)
                        {
                            <div class="lrm-flag flag-fail">
                                <span class="flag-pip">!</span>
                                @_report.BounceCount Bounce@(_report.BounceCount > 1 ? "s" : "")
                            </div>
                        }
                        else
                        {
                            <div class="lrm-flag flag-ok">
                                <span class="flag-pip">✓</span>
                                No Bounce
                            </div>
                        }
                        @if (_report.IsPersonalBest)
                        {
                            <div class="lrm-flag flag-best"><span class="flag-pip">★</span> Personal Best</div>
                        }
                        else if (_report.TotalLandings > 1)
                        {
                            <div class="lrm-flag flag-neutral">
                                <span class="flag-pip">#</span>
                                @_report.RankAmongLandings of @_report.TotalLandings · avg @_report.AverageScore
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ── RUNWAY DIVIDER ── -->
            <div class="lrm-rwy-strip" aria-hidden="true">
                @for (int d = 0; d < 6; d++)
                {
                    <div class="rwy-dash"></div>
                }
            </div>

            <!-- ── TOUCHDOWN PARAMETERS ── -->
            <div class="lrm-params-grid">
                @{
                    bool vsWarn   = _report.VerticalSpeedFpm > 600;
                    bool bankWarn = _report.BankDeg > 3;
                }
                <div class="lrm-param @(vsWarn ? "param-warn" : "")">
                    <span class="p-value">@_report.VerticalSpeedFpm.ToString("F0")</span>
                    <span class="p-unit">fpm</span>
                    <span class="p-label">VERT SPEED</span>
                </div>
                <div class="lrm-param">
                    <span class="p-value">@_report.IasKts.ToString("F0")</span>
                    <span class="p-unit">kt</span>
                    <span class="p-label">AIRSPEED</span>
                </div>
                <div class="lrm-param">
                    <span class="p-value">@_report.PitchDeg.ToString("F1")</span>
                    <span class="p-unit">°</span>
                    <span class="p-label">PITCH</span>
                </div>
                <div class="lrm-param @(bankWarn ? "param-warn" : "")">
                    <span class="p-value">@_report.BankDeg.ToString("F1")</span>
                    <span class="p-unit">°</span>
                    <span class="p-label">BANK</span>
                </div>
                <div class="lrm-param">
                    <span class="p-value">@_report.HeadwindKts.ToString("F0")</span>
                    <span class="p-unit">kt</span>
                    <span class="p-label">HEADWIND</span>
                </div>
                <div class="lrm-param">
                    <span class="p-value">@_report.CrosswindKts.ToString("F0")</span>
                    <span class="p-unit">kt</span>
                    <span class="p-label">CROSSWIND</span>
                </div>
            </div>

            <!-- ── SCORE BREAKDOWN ── -->
            <div class="lrm-breakdown">
                <div class="lrm-section-hd">SCORE BREAKDOWN</div>
                @{ var factors = _report.Factors; }
                @for (int fi = 0; fi < factors.Count; fi++)
                {
                    var f     = factors[fi];
                    var pct   = f.Pct;
                    var color = f.Color;
                    var delay = fi * 75 + 250; // stagger bars
                    <div class="lrm-factor" style="animation-delay: @(fi * 55)ms">
                        <span class="f-label">@f.Label</span>
                        <div class="f-track">
                            <div class="f-fill"
                                 style="width: @(_barsGo ? pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%" : "0%");
                                        background: @color;
                                        transition-delay: @(delay)ms">
                            </div>
                        </div>
                        <span class="f-pts" style="color: @color">
                            @f.Score.ToString("F0")<span class="f-max">/@((int)f.Max)</span>
                        </span>
                    </div>
                }
            </div>

            <!-- ── FOOTER STATS + CLOSE ── -->
            <div class="lrm-foot">
                @if (_report.RolloutFt > 10)
                {
                    <div class="lrm-foot-stat">
                        <div class="fs-val">@_report.RolloutFt.ToString("F0")</div>
                        <div class="fs-lbl">ft rollout</div>
                    </div>
                }
                @if (_report.ThresholdFt > 10)
                {
                    <div class="lrm-foot-stat">
                        <div class="fs-val">@_report.ThresholdFt.ToString("F0")</div>
                        <div class="fs-lbl">ft past threshold</div>
                    </div>
                }
                @if (_report.WindSpeedKts > 0)
                {
                    <div class="lrm-foot-stat">
                        <div class="fs-val">@_report.WindDirectionDeg.ToString("F0")°/@_report.WindSpeedKts.ToString("F0")</div>
                        <div class="fs-lbl">surface wind</div>
                    </div>
                }
                <div class="lrm-foot-stat">
                    <div class="fs-val">@_report.FuelLbs.ToString("F0")</div>
                    <div class="fs-lbl">lbs fuel</div>
                </div>
                <button class="lrm-dismiss-btn" @onclick="Dismiss">Close Report</button>
            </div>

        </div>
    </div>
}

@code {
    private bool          _visible;
    private bool          _animOut;
    private bool          _barsGo;          // triggers bar width transitions
    private double        _ringOffset = 502.65; // starts fully empty
    private LandingResult? _result;
    private LandingReport? _report;
    private System.Timers.Timer? _autoClose;

    /// <summary>
    /// Builds the shared report, enriching it with the owning flight and the
    /// full landing history (for the personal-best / ranking context).
    /// Failures here must never block the popup, so everything is best-effort.
    /// </summary>
    private async Task<LandingReport> BuildReportAsync(LandingResult result)
    {
        FlightRecord? flight = null;
        List<LandingResult>? history = null;
        try
        {
            history = await LandingRepo.GetAllAsync();
            if (Guid.TryParse(result.FlightId, out var fid))
                flight = (await FlightRepo.GetAllAsync()).FirstOrDefault(f => f.Id == fid);
        }
        catch (Exception ex) { Log.Debug(ex, "[LandingModal] Report context lookup failed"); }

        return LandingReportBuilder.Build(result, flight, history);
    }

    private const double Circumference = 502.65; // 2π×80

    protected override void OnInitialized()
    {
        AlertService.LandingResultReady += OnLandingResultReady;
    }

    private void OnLandingResultReady(object? sender, LandingResult result)
    {
        _ = InvokeAsync(async () =>
        {
            // Project through the SHARED report builder so this modal and the
            // EFB "Landing" app always show identical figures and wording.
            _report = await BuildReportAsync(result);

            // Reset animation state
            _result      = result;
            _animOut     = false;
            _barsGo      = false;
            _ringOffset  = Circumference; // start ring empty
            _visible     = true;
            StateHasChanged();            // first paint: ring empty, bars at 0

            // Slight delay so the browser has painted the "empty" state
            await Task.Delay(80);

            // Animate ring to final score
            _ringOffset = Circumference * (1.0 - result.LandingScore / 100.0);
            StateHasChanged();

            // Bars start slightly later for a staggered feel
            await Task.Delay(180);
            _barsGo = true;
            StateHasChanged();

            // Auto-dismiss after 60 s
            _autoClose?.Dispose();
            _autoClose        = new System.Timers.Timer(60_000);
            _autoClose.Elapsed += (_, _) => InvokeAsync(Dismiss);
            _autoClose.AutoReset = false;
            _autoClose.Start();
        });
    }

    private async Task Dismiss()
    {
        _autoClose?.Dispose();
        _autoClose = null;
        _animOut   = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(260);
        _visible = false;
        _animOut = false;
        await InvokeAsync(StateHasChanged);
    }

    // ── Helpers ────────────────────────────────────────────────

    private string GradeBg => _result?.LandingScore switch
    {
        >= 90 => "rgba(34,197,94,0.10)",
        >= 75 => "rgba(77,155,236,0.10)",
        >= 60 => "rgba(234,179,8,0.10)",
        >= 40 => "rgba(249,115,22,0.10)",
        _     => "rgba(239,68,68,0.10)"
    } ?? "rgba(148,163,184,0.10)";

    private static string FactorColor(double score, double max)
    {
        if (max <= 0) return "#94A3B8";
        return (score / max) switch
        {
            >= 0.85 => "#22C55E",
            >= 0.65 => "var(--accent)",
            >= 0.45 => "#EAB308",
            >= 0.25 => "#F97316",
            _       => "#EF4444"
        };
    }

    public void Dispose()
    {
        AlertService.LandingResultReady -= OnLandingResultReady;
        _autoClose?.Dispose();
    }
}
