<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Native voice pipeline round-trip test (Task 1) — same exact package versions
         pinned in AviatesAirTracker.csproj; see that file's comment for why. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NEbml" Version="1.1.0.5" />

    <!-- Native voice pipeline format-conversion test (Task 3): pulls in NAudio.Core
         (BufferedWaveProvider/ISampleProvider/WdlResamplingSampleProvider) for
         CaptureConverter.cs/VoiceSampleProviders.cs below. Neither of those files
         references NAudio.Wasapi/CoreAudioApi (device/COM types), so the plain
         "NAudio" meta-package is sufficient here; VoiceAudioEngine.cs itself
         (the actual WasapiCapture/WasapiOut device wiring) is deliberately NOT
         linked into this test project, since it cannot be meaningfully unit-tested
         without real audio hardware. Same 2.2.1 pin as AviatesAirTracker.csproj. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Native voice pipeline /voice wire-protocol test (Task 4): VoiceChannelClient.cs
         logs via Serilog (matching DispatchRadioService's own logging, the file it
         mirrors), pulled in here only for that static Log.* usage to compile; no
         sink is configured, so calls are inert no-ops in the test process. Same
         version pinned in AviatesAirTracker.csproj. -->
    <PackageReference Include="Serilog" Version="3.1.1" />

    <!-- EFB airport/runway parser (EfbAirportData.cs) reads the aviationweather.gov JSON
         with JObject. Same version pinned in AviatesAirTracker.csproj. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../AviatesAirTracker/Platform/IUiDispatcher.cs" Link="Platform/IUiDispatcher.cs" />
    <Compile Include="../../AviatesAirTracker/Platform/ImmediateUiDispatcher.cs" Link="Platform/ImmediateUiDispatcher.cs" />
    <Compile Include="../../AviatesAirTracker/Platform/WindowSubclass.cs" Link="Platform/WindowSubclass.cs" />
    <Compile Include="../../AviatesAirTracker/Core/SimConnect/SimConnectDefinitions.cs" Link="Core/SimConnect/SimConnectDefinitions.cs" />
    <Compile Include="../../AviatesAirTracker/Models/FlightModels.cs" Link="Models/FlightModels.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Data/JsonFileStore.cs" Link="Core/Data/JsonFileStore.cs" />
    <Compile Include="../../AviatesAirTracker/Platform/WindowPlacementLogic.cs" Link="Platform/WindowPlacementLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Services/StartupLaunchService.cs" Link="Services/StartupLaunchService.cs" />
    <Compile Include="../../AviatesAirTracker/Services/PreflightReadiness.cs" Link="Services/PreflightReadiness.cs" />
    <Compile Include="../../AviatesAirTracker/Services/CareerStatsLogic.cs" Link="Services/CareerStatsLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Reference/IcaoCountry.cs" Link="Core/Reference/IcaoCountry.cs" />
    <Compile Include="../../AviatesAirTracker/Shell/QuickSearchLogic.cs" Link="Shell/QuickSearchLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Analytics/LandingAssessment.cs" Link="Core/Analytics/LandingAssessment.cs" />
    <Compile Include="../../AviatesAirTracker/Services/FlightSessionState.cs" Link="Services/FlightSessionState.cs" />
    <Compile Include="../../AviatesAirTracker/Shell/ShellBadgeLogic.cs" Link="Shell/ShellBadgeLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Services/PilotStatsLogic.cs" Link="Services/PilotStatsLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Services/FlightsFilterLogic.cs" Link="Services/FlightsFilterLogic.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/OpusCodec.cs" Link="Services/Voice/OpusCodec.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/WebmMuxer.cs" Link="Services/Voice/WebmMuxer.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/WebmDemuxer.cs" Link="Services/Voice/WebmDemuxer.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/RadioDegradationEffect.cs" Link="Services/Voice/RadioDegradationEffect.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/VoiceSampleProviders.cs" Link="Services/Voice/VoiceSampleProviders.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Voice/CaptureConverter.cs" Link="Services/Voice/CaptureConverter.cs" />

    <!-- Native voice pipeline /voice wire-protocol test (Task 4): VoiceChannelClient's
         envelope encode/decode and JSON marker build/parse are pure static methods,
         testable without a live backend socket. VoiceChannelClient.cs itself doesn't
         reference System.Net.WebSockets types that need extra packages beyond the
         BCL, so no new PackageReference is needed for this link. -->
    <Compile Include="../../AviatesAirTracker/Services/Voice/VoiceChannelClient.cs" Link="Services/Voice/VoiceChannelClient.cs" />

    <!-- EFB Departure Perf: takeoff calculator (FLEX / OPT CONF / trim) and runway data parser
         are pure, dependency-free statics. -->
    <Compile Include="../../AviatesAirTracker/Core/Efb/AircraftPerformanceProfiles.cs" Link="Core/Efb/AircraftPerformanceProfiles.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbPerformanceCalculator.cs" Link="Core/Efb/EfbPerformanceCalculator.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbLandingFailures.cs" Link="Core/Efb/EfbLandingFailures.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbAirportData.cs" Link="Core/Efb/EfbAirportData.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbAtcGeo.cs" Link="Core/Efb/EfbAtcGeo.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Analytics/WeightBalanceDatabase.cs" Link="Core/Analytics/WeightBalanceDatabase.cs" />

    <!-- EFB Checklists: the per-aircraft checklist library and its check-state service
         (the service only depends on the library). -->
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbChecklistLibrary.cs" Link="Core/Efb/EfbChecklistLibrary.cs" />
    <Compile Include="../../AviatesAirTracker/Services/Efb/EfbChecklistService.cs" Link="Services/Efb/EfbChecklistService.cs" />

    <!-- Landing report: the shared LandingReport projection (flight-data view: trace distances,
         stabilised-approach gates, FDM events). Depends only on Models. -->
    <Compile Include="../../AviatesAirTracker/Core/Analytics/LandingReport.cs" Link="Core/Analytics/LandingReport.cs" />

    <!-- Manuals: the document library core (front-matter parser, search, generated QRH) and the
         company flap policy (CN-002 / CN-003). The tests read the real /Manuals markdown files. -->
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbManuals.cs" Link="Core/Efb/EfbManuals.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbCompanyPolicy.cs" Link="Core/Efb/EfbCompanyPolicy.cs" />
    <Compile Include="../../AviatesAirTracker/Core/Efb/EfbAcars.cs" Link="Core/Efb/EfbAcars.cs" />
  </ItemGroup>

</Project>
