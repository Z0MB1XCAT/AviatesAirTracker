<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AviatesAirTracker</RootNamespace>
    <AssemblyName>AviatesAirTracker</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>1.7.1</Version>
    <AssemblyVersion>1.7.1.0</AssemblyVersion>
    <FileVersion>1.7.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      SimConnect is loaded at RUNTIME via reflection — no build-time DLL reference.
      This means the project always compiles cleanly regardless of whether the
      MSFS SDK is installed. Place the managed wrapper DLL next to the EXE
      (or in Libs\) to enable live telemetry. See README.md for details.
    -->
    <DefineConstants>$(DefineConstants);NO_SIMCONNECT</DefineConstants>
  </PropertyGroup>

  <!-- EFB companion server — embedded ASP.NET Core (Kestrel) host.
       FrameworkReference pulls in Kestrel, minimal APIs, WebSockets and static-file
       middleware without adding NuGet packages. Works inside a WinExe/WPF process. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

    <!-- WinUI 3 / Windows App SDK.
         Versions are pinned deliberately — 1.6/1.7 cannot build without Visual Studio
         (MSB4062 in MrtCore.PriGen.targets). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- Map — kept for legacy; Blazor map uses Leaflet.js via JS interop -->
    <PackageReference Include="Mapsui.Tiling" Version="4.1.7" />
    <PackageReference Include="Mapsui.Nts" Version="4.1.7" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- HTTP -->
    <PackageReference Include="RestSharp" Version="112.1.0" />

    <!-- Discord Rich Presence -->
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />

    <!-- Joystick/HOTAS input for dispatch radio PTT binding -->
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
  </ItemGroup>

  <!-- The loopback Blazor Server host (AviatesAirTracker.LegacyWeb\Hosting\BlazorHostServer.cs,
       moved there in Task 8 of the WinUI 3 migration) serves wwwroot from DISK via a
       PhysicalFileProvider rooted at AppContext.BaseDirectory, so these files must sit next
       to the exe. The Razor static-web-assets pipeline alone does not put them there in a
       plain build. Transitional, like the rest of the legacy UI host.

       NOTE: this is Update, not Include. The SDK already globs wwwroot\**\* into Content
       by default, so Include duplicates every file and fails the build with NETSDK1022.
       Update just adds the copy-to-output metadata to the items already there. -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Assets\**\*" Condition="Exists('Resources\Assets')" />
  </ItemGroup>

  <!-- EFB tablet frontend — embedded into the assembly so it ships inside the
       single-file exe (no loose files on disk). Served by EfbServer from the
       manifest resource stream. Kept OUTSIDE wwwroot so the Blazor/Razor static
       web-asset pipeline does not also process it. Files are flat (no subfolders)
       so resource-name → request-path mapping is a trivial prefix strip. -->
  <ItemGroup>
    <EmbeddedResource Include="EfbWeb\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- SimConnect DLLs — loaded at runtime via reflection, not build-time references.
         Place both DLLs from [MSFS SDK]\SimConnect SDK\lib\ into this project's Libs\ folder:
           - managed\Microsoft.FlightSimulator.SimConnect.dll  (managed wrapper)
           - SimConnect.dll                                      (native client library)
         The managed wrapper P/Invokes into the native DLL; both must be present. -->
    <None Include="Libs\Microsoft.FlightSimulator.SimConnect.dll" Condition="Exists('Libs\Microsoft.FlightSimulator.SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\Microsoft.FlightSimulator.SimConnect.dll</Link>
    </None>
    <None Include="Libs\SimConnect.dll" Condition="Exists('Libs\SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\SimConnect.dll</Link>
    </None>
    <!-- MSFS 2020 SDK DLLs — optional; place in Libs\MSFS2020\ to enable MSFS 2020 support.
         Source: [MSFS 2020 SDK]\SimConnect SDK\lib\managed\ and lib\
         See the comment block at the top of SimConnectManager.cs for instructions. -->
    <None Include="Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll"
          Condition="Exists('Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll</Link>
    </None>
    <None Include="Libs\MSFS2020\SimConnect.dll"
          Condition="Exists('Libs\MSFS2020\SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\MSFS2020\SimConnect.dll</Link>
    </None>
  </ItemGroup>

</Project>
