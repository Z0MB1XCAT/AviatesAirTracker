<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AviatesAirTracker</RootNamespace>
    <AssemblyName>AviatesAirTracker</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>1.7.1</Version>
    <AssemblyVersion>1.7.1.0</AssemblyVersion>
    <FileVersion>1.7.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      SimConnect is loaded at RUNTIME via reflection — no build-time DLL reference.
      This means the project always compiles cleanly regardless of whether the
      MSFS SDK is installed. Place the managed wrapper DLL next to the EXE
      (or in Libs\) to enable live telemetry. See README.md for details.
    -->
    <DefineConstants>$(DefineConstants);NO_SIMCONNECT</DefineConstants>
  </PropertyGroup>

  <!-- EFB companion server — embedded ASP.NET Core (Kestrel) host.
       FrameworkReference pulls in Kestrel, minimal APIs, WebSockets and static-file
       middleware without adding NuGet packages. Works inside a WinExe/WPF process. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

    <!-- WinUI 3 / Windows App SDK.
         Versions are pinned deliberately — 1.6/1.7 cannot build without Visual Studio
         (MSB4062 in MrtCore.PriGen.targets). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- Map — native WinUI 3 map engine (Phase 4). The WinUI control package's actual
         NuGet id is "Mapsui.WinUI" (NOT "Mapsui.UI.WinUI" — that id does not exist on
         nuget.org; confirmed via nuget search during the Task 1 spike), pinned to the
         same 4.1.7 version as the already-referenced Mapsui.Tiling/Mapsui.Nts to avoid
         cross-package version-mismatch type-load failures. -->
    <PackageReference Include="Mapsui.Tiling" Version="4.1.7" />
    <PackageReference Include="Mapsui.Nts" Version="4.1.7" />
    <PackageReference Include="Mapsui.WinUI" Version="4.1.7" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- HTTP -->
    <PackageReference Include="RestSharp" Version="112.1.0" />

    <!-- Discord Rich Presence -->
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />

    <!-- Joystick/HOTAS input for dispatch radio PTT binding -->
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />

    <!-- Native voice pipeline (Phase: native voice) — Opus encode/decode (pure managed,
         no P/Invoke) and a generic EBML reader/writer used to mux/demux the WebM/Opus
         container that voice.js used to produce via MediaRecorder. Exact versions pinned
         per the design spec's hands-on spike; do not bump without re-verifying against
         net8.0-windows10.0.19041.0. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NEbml" Version="1.1.0.5" />

    <!-- NAudio pinned to 2.2.1 EXACTLY — the latest (3.0.1) dropped net8.0 support
         entirely and fails to restore against this app's net8.0-windows10.0.19041.0
         TFM. Confirmed against this exact TFM by the design spec's hands-on spike;
         do not bump without re-verifying. Used for WASAPI capture/render
         (VoiceAudioEngine) — MMDeviceEnumerator/WasapiCapture/WasapiOut. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
  </ItemGroup>

  <!-- The loopback Blazor Server host (AviatesAirTracker.LegacyWeb\Hosting\BlazorHostServer.cs,
       moved there in Task 8 of the WinUI 3 migration) serves wwwroot from DISK via a
       PhysicalFileProvider rooted at AppContext.BaseDirectory, so these files must sit next
       to the exe. The Razor static-web-assets pipeline alone does not put them there in a
       plain build. Transitional, like the rest of the legacy UI host.

       This project's Sdk is plain "Microsoft.NET.Sdk" (see the top of this file), not
       "Microsoft.NET.Sdk.Razor" or "Microsoft.NET.Sdk.Web"; that switch happened earlier in
       the WinUI 3 migration (UseWinUI=true requires it) but this ItemGroup was never updated
       to match. The comment this replaces claimed "the SDK already globs wwwroot\**\* into
       Content by default" and used Update instead of Include to avoid a supposed NETSDK1022
       duplicate-item error; that auto-globbing-as-Content behavior is specific to the
       Razor/Web SDKs, which this project no longer uses. Under plain Microsoft.NET.Sdk,
       non-code files glob as None items, not Content, so Content Update here was matching
       zero items and silently no-op'ing: wwwroot never actually reached the output directory
       (confirmed empirically: a clean rebuild still produced an output wwwroot containing
       only the Razor-generated scoped-CSS bundle, none of the real assets). Include is the
       correct verb now; there is no pre-existing Content item of the same type for it to
       duplicate. -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Assets\**\*" Condition="Exists('Resources\Assets')" />
  </ItemGroup>

  <!-- WinUI shell chrome assets — bundled fonts (Syne, Plus Jakarta Sans) and a raster
       copy of the app icon for the WinUI Image control. See Phase 2 shell-visual plan,
       Task 1. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIconSmall.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- EFB tablet frontend — embedded into the assembly so it ships inside the
       single-file exe (no loose files on disk). Served by EfbServer from the
       manifest resource stream. Kept OUTSIDE wwwroot so the Blazor/Razor static
       web-asset pipeline does not also process it. Files are flat (no subfolders)
       so resource-name → request-path mapping is a trivial prefix strip. -->
  <ItemGroup>
    <EmbeddedResource Include="EfbWeb\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- SimConnect DLLs — loaded at runtime via reflection, not build-time references.
         Place both DLLs from [MSFS SDK]\SimConnect SDK\lib\ into this project's Libs\ folder:
           - managed\Microsoft.FlightSimulator.SimConnect.dll  (managed wrapper)
           - SimConnect.dll                                      (native client library)
         The managed wrapper P/Invokes into the native DLL; both must be present. -->
    <None Include="Libs\Microsoft.FlightSimulator.SimConnect.dll" Condition="Exists('Libs\Microsoft.FlightSimulator.SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\Microsoft.FlightSimulator.SimConnect.dll</Link>
    </None>
    <None Include="Libs\SimConnect.dll" Condition="Exists('Libs\SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\SimConnect.dll</Link>
    </None>
    <!-- MSFS 2020 SDK DLLs — optional; place in Libs\MSFS2020\ to enable MSFS 2020 support.
         Source: [MSFS 2020 SDK]\SimConnect SDK\lib\managed\ and lib\
         See the comment block at the top of SimConnectManager.cs for instructions. -->
    <None Include="Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll"
          Condition="Exists('Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\MSFS2020\Microsoft.FlightSimulator.SimConnect.dll</Link>
    </None>
    <None Include="Libs\MSFS2020\SimConnect.dll"
          Condition="Exists('Libs\MSFS2020\SimConnect.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Libs\MSFS2020\SimConnect.dll</Link>
    </None>
  </ItemGroup>

</Project>
