<Window
    x:Class="AviatesAirTracker.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag region for the extended title bar. Caption buttons are drawn by the
             system; this Border only supplies the draggable area and the app name. -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="9">
                <Image Source="/Assets/AppIconSmall.png" Width="18" Height="18" />
                <TextBlock
                    Text="Aviates Air Flight Tracker"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DisplayFontBold}"
                    FontSize="12.5"
                    Foreground="#B8FFFFFF" />
            </StackPanel>
        </Border>

        <!-- Hidden by default: the login gate in ShellWindow.xaml.cs only reveals these once
             OnFirstActivated's async IsLoggedIn() check confirms a signed-in pilot. Defaulting
             to visible would show the full rail and back button for the brief startup gap
             before that check can run, even for a signed-out pilot. -->
        <controls:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavSelectionChanged"
            BackRequested="OnBackRequested">
            <Frame x:Name="NativeHost" />
        </controls:NavigationView>

        <!-- In-app toasts (ToastPresenter builds each one in code). -->
        <StackPanel x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,22,0" Spacing="10" />

        <!-- Full-window overlays built in code: the mandatory-update screen. -->
        <Grid x:Name="OverlayHost" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
