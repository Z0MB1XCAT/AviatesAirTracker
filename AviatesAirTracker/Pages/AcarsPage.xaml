<Page
    x:Class="AviatesAirTracker.Pages.AcarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Acars.razor (dark theme values
      from wwwroot\css\app.css's html[data-theme="dark"] block), following the same rules every
      prior native page in this migration has followed: no Style element anywhere (silently
      crashes XamlCompiler.exe on this SDK, zero diagnostics), no literal double-hyphen inside any
      XAML comment (invalid XML, same silent crash — a single hyphen or the box-drawing "──"
      character is used instead), no malformed hex color literal (anything other than 3/6/8 hex
      digits after '#' builds clean but throws XamlParseException at runtime), and no Button
      anywhere (Border + Tapped for every clickable element instead).

      Task 3 of the ACARS native-page plan ("skeleton"): header, connection status banner, active
      booking banner, aircraft identification strip, instrument row, progress/ETA strip, the
      mini-map + sidebar grid (SimBrief/Flight-Plan card, Flight Phase card, ACARS Key card), and
      the flight event log. The AcarsFmc floating "FMC datalink" window is deliberately NOT
      ported — confirmed by the design spec's research to be purely decorative (hardcoded
      placeholder text, not wired to any real data), dropped as a small, explicit scope cut.

      Task 4 (this file's job now) adds: the OFP details strip (waypoint route, METAR cards,
      NOTAMs, Hoppies ACARS log, OFP text viewer, PIREP panel), the End Flight confirmation
      ContentDialog (AviatesAirTracker.Dialogs.ConfirmDialog — the first plain confirm-modal in
      this migration), the OFP-import wipe-warning ContentDialog (same ConfirmDialog), and the
      flight completion overlay (a right-docked slide-in panel, positioned via a wrapping Grid
      below rather than the ScrollViewer being the Page's sole child, so it can render on top of
      the whole scrollable page like Acars.razor's own `position:fixed; inset:0` overlay).

      Mini-map: a second, independent Mapsui.UI.WinUI.MapControl + NativeMapRenderer instance
      (constructed in code-behind, matching MapPage.xaml.cs's convention of never declaring the
      third-party map control type in XAML) is inserted into MiniMapHost below. This map only ever
      calls Init/UpdatePosition/UpdateFlightPathAltitude — no planned route, no airport markers,
      no other-pilot markers, no pointer hit-testing, matching the legacy mini-map's own reduced
      feature set exactly (design spec, "Mini-map: reuse NativeMapRenderer directly").

      Decorative CSS animations (the connecting/connected status dot's spin/breathe keyframes) are
      not reproduced — a static dot color is shown instead, the same simplification FleetPage.xaml
      already made for its refresh icon ("Static icon, not spun on IsLoading").
    -->

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Header (Acars.razor:21-28) ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="ACARS / Tracking" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Real-time flight tracking, telemetry, and ACARS communications. Connect MSFS to go live."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Connection status banner (Acars.razor:30-63) ── -->
            <Border x:Name="ConnectionBannerBorder"
                    Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5"
                    CornerRadius="20" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#121A2A"
                            VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#64748B"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="BannerTitleText" Text="ACARS Offline: MSFS Not Connected"
                                   FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" />
                        <TextBlock x:Name="BannerDescText"
                                   Text="Launch Microsoft Flight Simulator to begin automatic ACARS tracking. All flight data will be recorded in real-time."
                                   FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="UtcClockText" Grid.Column="2" Text="--:--:--"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#64748B"
                               CharacterSpacing="40" VerticalAlignment="Center" />

                    <!-- Exactly one of these three is visible at a time (see UpdateConnectionBanner). -->
                    <Border x:Name="ConnectButtonBorder" Grid.Column="3" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnConnectTapped" AutomationProperties.Name="Connect"
                                                                         Tapped="OnConnectTapped"
                            Background="#4D9BEC" CornerRadius="10" Padding="16,7" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectButtonText" Text="Connect" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <StackPanel x:Name="LiveGroupPanel" Grid.Column="3" Orientation="Horizontal" Spacing="10"
                                Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Background="#1F3EC7AC" CornerRadius="10" Padding="10,3">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="#3EC7AC" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#3EC7AC" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="EndFlightButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnEndFlightTapped" AutomationProperties.Name="End Flight"
                                                               Tapped="OnEndFlightTapped"
                                Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1.5"
                                CornerRadius="10" Padding="16,6">
                            <TextBlock Text="End Flight" FontSize="12" FontWeight="Bold" Foreground="#EF4444" />
                        </Border>
                    </StackPanel>

                    <Border x:Name="CompleteChipBorder" Grid.Column="3"
                            Background="#1F4D9BEC" CornerRadius="10" Padding="10,3"
                            Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="#4D9BEC" VerticalAlignment="Center" />
                            <TextBlock Text="Complete" FontSize="11" FontWeight="SemiBold" Foreground="#4D9BEC" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Active booking banner (Acars.razor:65-95) ── -->
            <Border x:Name="BookingBannerBorder"
                    Background="#0C111D" BorderBrush="#384D9BEC" BorderThickness="1"
                    CornerRadius="20" Padding="20,12" Visibility="Collapsed">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="-6" VerticalAlignment="Center">
                        <Image x:Name="BookingFlagDepImage" Width="20" Height="14" Visibility="Collapsed" />
                        <Image x:Name="BookingFlagArrImage" Width="20" Height="14" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock x:Name="BookingCallsignText" Grid.Column="1" Text=""
                               FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#4D9BEC"
                               CharacterSpacing="30" VerticalAlignment="Center" />

                    <TextBlock x:Name="BookingFltNumText" Grid.Column="2" Text=""
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Visibility="Collapsed" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="BookingOriginText" Text="----" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="16" Foreground="#F1F5F9" />
                        <TextBlock Text="→" FontSize="13" Foreground="#5FFFFFFF" />
                        <TextBlock x:Name="BookingDestText" Text="----" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="16" Foreground="#F1F5F9" />
                    </StackPanel>

                    <Border Grid.Column="4" Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="BookingAircraftTypeText" Text="" FontFamily="Consolas"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>

                    <TextBlock Grid.Column="5" Text="SimBrief opened in browser; generate your plan, then click Fetch OFP below"
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" />

                    <Border x:Name="BookingDismissBorder" Grid.Column="6" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnBookingDismissTapped" AutomationProperties.Name="Dismiss booking banner"
                                                                          Tapped="OnBookingDismissTapped"
                            Width="24" Height="24" Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="9999" VerticalAlignment="Center">
                        <TextBlock Text="×" FontSize="14" Foreground="#64748B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ── Pre-flight readiness ──
                 Shown while no flight is being tracked: everything that decides whether the next
                 flight is tracked and logged properly. Rows are built in code (UpdateReadiness). -->
            <Border x:Name="ReadinessBorder" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Before you fly" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="16" Foreground="#F1F5F9" />
                            <TextBlock Text="Check these before starting the engines so the flight is tracked and logged properly."
                                       FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="ReadinessSummaryText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="ReadinessGrid" ColumnSpacing="24" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Aircraft identification strip (Acars.razor:97-133) ── -->
            <Border x:Name="AircraftIdStripBorder"
                    Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="20,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="✈" FontSize="16" Foreground="#4D9BEC" />
                        <TextBlock x:Name="AtcModelText" Text="" FontFamily="Consolas" FontSize="13"
                                   FontWeight="Bold" Foreground="#F1F5F9" />
                    </StackPanel>
                    <StackPanel x:Name="CallsignGroup" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="CALLSIGN" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                        <TextBlock x:Name="AtcIdText" Text="" FontFamily="Consolas" FontSize="13" Foreground="#F1F5F9" />
                    </StackPanel>
                    <StackPanel x:Name="FlightNumGroup" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="FLIGHT" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                        <TextBlock x:Name="AtcFlightNumberText" Text="" FontFamily="Consolas" FontSize="13" Foreground="#F1F5F9" />
                    </StackPanel>
                    <StackPanel x:Name="ActiveLegGroup" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE LEG" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                        <TextBlock x:Name="GpsActiveLegText" Text="" FontFamily="Consolas" FontSize="13" Foreground="#4D9BEC" />
                    </StackPanel>
                    <TextBlock x:Name="AircraftCoordsText" Text="" FontFamily="Consolas" FontSize="11" Foreground="#64748B"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Instrument row (Acars.razor:135-167 / app.css:1270-1306) ── -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ALTITUDE MSL" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="AltValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="ft" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AIRSPEED IAS" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="IasValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="kts" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="VERTICAL SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="VsValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="fpm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="HEADING" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="HdgValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="°" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GROUND SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="GsValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="kts" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MACH" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="120" />
                        <TextBlock x:Name="MachValueText" Text="—" FontFamily="{StaticResource DisplayFontBold}" FontSize="28" Foreground="#64748B" />
                        <TextBlock Text="M" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Flight progress + ETA strip (Acars.razor:169-212) ── -->
            <Border x:Name="ProgressStripBorder"
                    Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="20,12" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressDepText" Grid.Column="0" Text="----" FontFamily="Consolas"
                                   FontSize="11" FontWeight="Bold" Foreground="#3EC7AC" MinWidth="36" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="6" Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="9999" VerticalAlignment="Center">
                            <Grid x:Name="ProgressBarTrack" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ProgressFillColumn" Width="0*" />
                                    <ColumnDefinition x:Name="ProgressRemainderColumn" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9999" Background="#4D9BEC" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ProgressArrText" Grid.Column="2" Text="----" FontFamily="Consolas"
                                   FontSize="11" FontWeight="Bold" Foreground="#F59E0B" MinWidth="36" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="EN ROUTE" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                            <TextBlock x:Name="EnRouteText" Text="—:——" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                        </StackPanel>
                        <Border Width="1" Height="12" Background="#14FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="FLOWN" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                            <TextBlock x:Name="DistFlownText" Text="0 nm" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                        </StackPanel>
                        <Border Width="1" Height="12" Background="#14FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="REMAINING" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                            <TextBlock x:Name="DistRemainingText" Text="—" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                        </StackPanel>
                        <Border Width="1" Height="12" Background="#14FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="ETA" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                            <TextBlock x:Name="EtaText" Text="—" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                        </StackPanel>
                        <StackPanel x:Name="XtkGroup" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                            <Border Width="1" Height="12" Background="#14FFFFFF" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="DEVIATION" FontSize="10" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100" />
                                <TextBlock x:Name="XtkLabelValueText" Text="—" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Mini-map + sidebar (Acars.razor:214-372) ── -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: mini map. MapControl is added to MiniMapHost's Children in code-behind,
                     same reasoning as MapPage.xaml's own MapHost — avoids a brand-new third-party
                     xmlns import into this project's XAML. -->
                <Border Grid.Column="0" CornerRadius="20" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Background="#0C111D" MinHeight="380">
                    <Grid>
                        <!-- No fixed Height: the map fills whatever height this Border ends up
                             (it stretches to match the taller sidebar column via the shared row).
                             A fixed Height here left the MapControl's own height locked at 380
                             while the Border grew taller than that to match the sidebar, so the
                             Grid centered the shorter map inside it, letterboxing it with the
                             Border's own dark background showing as bars above and below. -->
                        <Grid x:Name="MiniMapHost" />
                        <Border x:Name="FullMapLinkBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnFullMapTapped" AutomationProperties.Name="Open full map"
                                                           Tapped="OnFullMapTapped"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                Background="#D20A0D17" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="14,6">
                            <TextBlock Text="Full Map ↗" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: sidebar -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- SimBrief / Flight Plan card -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="0">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Flight Plan" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                                <Border x:Name="ClearPlanButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnClearPlanTapped" AutomationProperties.Name="Clear flight plan"
                                                                       Tapped="OnClearPlanTapped"
                                        HorizontalAlignment="Right" Padding="6,2" Visibility="Collapsed">
                                    <TextBlock Text="Clear" FontSize="11" Foreground="#64748B" />
                                </Border>
                            </Grid>

                            <!-- State 1: plan loaded -->
                            <StackPanel x:Name="SimBriefPlanPanel" Visibility="Collapsed" Spacing="12">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="SimBriefRouteDepText" Text="----" FontFamily="Consolas"
                                                   FontSize="22" FontWeight="Black" Foreground="#F1F5F9" />
                                        <TextBlock Text="→" FontSize="16" Foreground="#4D9BEC" />
                                        <TextBlock x:Name="SimBriefRouteArrText" Text="----" FontFamily="Consolas"
                                                   FontSize="22" FontWeight="Black" Foreground="#F1F5F9" />
                                    </StackPanel>
                                    <TextBlock x:Name="SimBriefAircraftText" Text="" FontSize="12" Foreground="#64748B"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <Grid x:Name="SimBriefCruiseRow" Visibility="Collapsed">
                                        <TextBlock Text="Cruise" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="SimBriefCruiseValueText" Text="" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid x:Name="SimBriefDistanceRow" Visibility="Collapsed">
                                        <TextBlock Text="Distance" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="SimBriefDistanceValueText" Text="" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid x:Name="SimBriefEteRow" Visibility="Collapsed">
                                        <TextBlock Text="ETE" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="SimBriefEteValueText" Text="" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid x:Name="SimBriefFuelRow" Visibility="Collapsed">
                                        <TextBlock Text="TOW Fuel" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="SimBriefFuelValueText" Text="" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid x:Name="SimBriefFixesRow" Visibility="Collapsed">
                                        <TextBlock Text="Fixes" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="SimBriefFixesValueText" Text="" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="RefreshOfpButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRefreshOfpTapped" AutomationProperties.Name="Refresh OFP"
                                                                        Tapped="OnRefreshOfpTapped"
                                        Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="0,8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Refresh OFP" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- State 2: loading -->
                            <StackPanel x:Name="SimBriefLoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                        Padding="0,16" Spacing="8">
                                <ProgressRing IsActive="True" Width="20" Height="20" Foreground="#4D9BEC" />
                                <TextBlock Text="Fetching from SimBrief..." FontSize="12" Foreground="#64748B" />
                            </StackPanel>

                            <!-- State 3: no plan yet -->
                            <StackPanel x:Name="SimBriefEmptyPanel" Visibility="Visible" Spacing="12">
                                <Border x:Name="SimBriefErrorBorder" Visibility="Collapsed"
                                        Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1"
                                        CornerRadius="12" Padding="10,8">
                                    <TextBlock x:Name="SimBriefErrorText" Text="" FontSize="11.5" Foreground="#EF4444"
                                               TextWrapping="Wrap" />
                                </Border>

                                <StackPanel x:Name="SimBriefNoUsernamePanel" Visibility="Collapsed" Spacing="10">
                                    <TextBlock Text="No SimBrief username configured." FontSize="12" Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                    <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnConfigureSimBriefTapped" AutomationProperties.Name="Configure SimBrief"
                                            Tapped="OnConfigureSimBriefTapped"
                                            Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="0,8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Configure SimBrief" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="SimBriefHasUsernamePanel" Visibility="Collapsed" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Pilot ID:" FontSize="11" Foreground="#64748B" />
                                        <TextBlock x:Name="SimBriefUsernameText" Text="" FontFamily="Consolas" FontSize="11"
                                                   Foreground="#CBD5E1" />
                                    </StackPanel>
                                    <Border x:Name="ImportOfpButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnImportOfpTapped" AutomationProperties.Name="Import Latest OFP"
                                                                           Tapped="OnImportOfpTapped"
                                            Background="#4D9BEC" CornerRadius="10" Padding="0,8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Import Latest OFP" FontSize="12" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Flight Phase card -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Flight Phase" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="15" Foreground="#F1F5F9" />
                            <StackPanel Spacing="8">
                                <Border x:Name="PhaseParkedRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseParkedDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseParkedText" Text="Parked" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseTaxiRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseTaxiDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseTaxiText" Text="Taxi" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseClimbRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseClimbDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseClimbText" Text="Climb" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseCruiseRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseCruiseDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseCruiseText" Text="Cruise" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseDescentRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseDescentDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseDescentText" Text="Descent" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseApproachRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseApproachDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseApproachText" Text="Approach" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PhaseLandingRow" Background="#161D2E" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse x:Name="PhaseLandingDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PhaseLandingText" Text="Landing" FontSize="13" FontWeight="Medium" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ACARS Key card -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ACARS Key" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="15" Foreground="#F1F5F9" />

                            <Border x:Name="AcarsKeyValueBorder" Background="#121A2A" CornerRadius="10" Padding="12,10" Visibility="Collapsed">
                                <TextBlock x:Name="AcarsKeyMaskedText" Text="" FontFamily="Consolas" FontSize="12"
                                           Foreground="#64748B" CharacterSpacing="60" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border x:Name="AcarsKeyEmptyBorder" Background="#121A2A" CornerRadius="10" Padding="12,10" Visibility="Collapsed">
                                <TextBlock Text="Not configured" FontFamily="Consolas" FontSize="12" Foreground="#64748B" />
                            </Border>

                            <Grid x:Name="FriendCodeRow" Visibility="Collapsed">
                                <TextBlock Text="Friend Code" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" />
                                <TextBlock x:Name="FriendCodeText" Text="" FontFamily="Consolas" FontSize="12"
                                           FontWeight="Bold" Foreground="#4D9BEC" CharacterSpacing="100" HorizontalAlignment="Right" />
                            </Grid>

                            <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnConfigureAcarsTapped" AutomationProperties.Name="Configure ACARS"
                                    Tapped="OnConfigureAcarsTapped"
                                    Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="0,8" HorizontalAlignment="Stretch">
                                <TextBlock Text="Configure ACARS" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- ── Flight event log (Acars.razor:374-393) ── -->
            <Border x:Name="EventLogSectionBorder"
                    Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Flight Events" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                        <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnClearEventLogTapped" AutomationProperties.Name="Clear event log"
                                Tapped="OnClearEventLogTapped" HorizontalAlignment="Right" Padding="6,2">
                            <TextBlock Text="Clear" FontSize="11" Foreground="#64748B" />
                        </Border>
                    </Grid>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventLogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#CBD5E1"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ── SimBrief OFP details strip (Acars.razor:395-664) — only when a plan is loaded ── -->
            <StackPanel x:Name="OfpDetailsStripPanel" Spacing="20" Visibility="Collapsed">

                <!-- Waypoint route strip (Acars.razor:401-437) -->
                <Border x:Name="WaypointStripBorder"
                        Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock x:Name="WaypointStripTitleText" Text="Route" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                            <TextBlock x:Name="WaypointSidStarText" Text="" FontFamily="Consolas" FontSize="11"
                                       Foreground="#64748B" HorizontalAlignment="Right" Visibility="Collapsed" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="WaypointChipsPanel" Orientation="Horizontal" Spacing="5" />
                        </ScrollViewer>
                        <TextBlock x:Name="WaypointRawRouteText" Text="" FontFamily="Consolas" FontSize="11"
                                   Foreground="#64748B" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- METAR cards — DEP / ARR / ALT (Acars.razor:439-506) -->
                <Grid x:Name="MetarCardsGrid" ColumnSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DepMetarCardBorder" Grid.Column="0"
                            Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock x:Name="DepMetarTitleText" Text="DEP METAR" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock x:Name="DepMetarTimeText" Text="" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRefreshMetarsTapped" AutomationProperties.Name="Refresh METARs"
                                            Tapped="OnRefreshMetarsTapped" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="DepMetarRefreshIconText" Text="↻" FontSize="11" FontWeight="Bold" Foreground="#4D9BEC" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Background="#121A2A" CornerRadius="12" Padding="12,10">
                                <TextBlock x:Name="DepMetarBodyText" Text="" FontFamily="Consolas" FontSize="11"
                                           Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="19" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ArrMetarCardBorder" Grid.Column="1"
                            Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock x:Name="ArrMetarTitleText" Text="ARR METAR" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ArrMetarTimeText" Text="" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRefreshMetarsTapped" AutomationProperties.Name="Refresh METARs"
                                            Tapped="OnRefreshMetarsTapped" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ArrMetarRefreshIconText" Text="↻" FontSize="11" FontWeight="Bold" Foreground="#4D9BEC" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Background="#121A2A" CornerRadius="12" Padding="12,10">
                                <TextBlock x:Name="ArrMetarBodyText" Text="" FontFamily="Consolas" FontSize="11"
                                           Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="19" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AltMetarCardBorder" Grid.Column="2"
                            Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock x:Name="AltMetarTitleText" Text="ALT METAR" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AltMetarTimeText" Text="" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRefreshMetarsTapped" AutomationProperties.Name="Refresh METARs"
                                            Tapped="OnRefreshMetarsTapped" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AltMetarRefreshIconText" Text="↻" FontSize="11" FontWeight="Bold" Foreground="#4D9BEC" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Background="#121A2A" CornerRadius="12" Padding="12,10">
                                <TextBlock x:Name="AltMetarBodyText" Text="" FontFamily="Consolas" FontSize="11"
                                           Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="19" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- NOTAMs panel — collapsible (Acars.razor:508-526) -->
                <Border x:Name="NotamsBorder"
                        Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="0">
                        <Grid IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnToggleNotamsTapped" AutomationProperties.Name="NOTAMs"
                              Tapped="OnToggleNotamsTapped" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                <TextBlock Text="NOTAMs" FontFamily="{StaticResource DisplayFontBold}" FontSize="15" Foreground="#F1F5F9" />
                                <TextBlock x:Name="NotamsCountText" Text="" FontSize="11" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="NotamsChevronText" Text="▼" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel x:Name="NotamsListPanel" Spacing="12" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Hoppies ACARS Log panel — read-only (Acars.razor:528-550) -->
                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Hoppies ACARS Log" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="15" Foreground="#F1F5F9" Margin="0,0,0,12" />
                        <TextBlock x:Name="HoppiesLogEmptyText" Text="No messages sent yet this session."
                                   FontSize="12" Foreground="#64748B" />
                        <ScrollViewer x:Name="HoppiesLogScrollViewer" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="HoppiesLogItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Foreground="#64748B"
                                                       Opacity="0.7" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- OFP text viewer — collapsible (Acars.razor:552-567) -->
                <Border x:Name="OfpTextBorder"
                        Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="0">
                        <Grid IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnToggleOfpTextTapped" AutomationProperties.Name="OFP Text"
                              Tapped="OnToggleOfpTextTapped" Margin="0,0,0,8">
                            <TextBlock Text="OFP Text" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="15" Foreground="#F1F5F9" HorizontalAlignment="Left" />
                            <TextBlock x:Name="OfpTextChevronText" Text="▼" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" />
                        </Grid>
                        <ScrollViewer x:Name="OfpTextScrollViewer" MaxHeight="400" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <Border Background="#121A2A" CornerRadius="12" Padding="14,12">
                                <TextBlock x:Name="OfpTextBodyText" Text="" FontFamily="Consolas" FontSize="10"
                                           Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- ── Flight completion overlay (Acars.razor:1414-1479) — right-docked slide-in panel,
         full-height. Tapping the transparent backdrop dismisses; tapping inside the panel does not
         (Handled=true stops the Tapped bubble at CompletionPanelBorder, mirroring @onclick +
         @onclick:stopPropagation). accent color here uses the CURRENT app accent (#4D9BEC), not
         Acars.razor.css's literal #3D7EEE (the app's *previous* accent, same stale-magic-number
         situation this file's own ActivePhaseRowBrush comment already found and fixed elsewhere on
         this page — applied consistently here rather than reintroducing the stale value). ── -->
    <Grid x:Name="CompletionOverlayGrid" Background="Transparent" Visibility="Collapsed" Tapped="OnCompletionOverlayTapped">
        <Border x:Name="CompletionPanelBorder" Tapped="OnCompletionPanelTapped"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="340"
                BorderBrush="#594D9BEC" BorderThickness="2,0,0,0" Padding="24,32,24,28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111827" Offset="0" />
                    <GradientStop Color="#0F172A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0">

                    <StackPanel Spacing="6" Margin="0,0,0,24">
                        <TextBlock Text="✦ FLIGHT COMPLETE" FontSize="10" FontWeight="Bold" Foreground="#4D9BEC" CharacterSpacing="150" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompletionDepText" Text="----" FontFamily="Consolas" FontSize="26" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="→" FontSize="20" Foreground="#4D9BEC" Margin="6,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompletionArrText" Text="----" FontFamily="Consolas" FontSize="26" FontWeight="Black" Foreground="White" />
                        </StackPanel>
                        <TextBlock x:Name="CompletionSubText" Text="" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,0,0,20">
                        <Border Background="#0A0D17" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <TextBlock Text="Landing VS" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompletionVsText" Text="—" FontSize="16" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Border Background="#0A0D17" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <TextBlock Text="Score" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompletionScoreText" Text="—" FontSize="16" FontWeight="ExtraBold" Foreground="#4D9BEC" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Border Background="#0A0D17" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <TextBlock Text="Air Time" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompletionAirTimeText" Text="—" FontSize="16" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Border Background="#0A0D17" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <TextBlock Text="Distance" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompletionDistanceText" Text="—" FontSize="16" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Border Background="#0A0D17" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <TextBlock Text="Fuel Used" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompletionFuelText" Text="—" FontSize="16" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="CompletionRankupBorder" CornerRadius="10" Padding="14" Margin="0,0,0,20" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F8B5CF6" Offset="0" />
                                <GradientStop Color="#144D9BEC" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🎖" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Spacing="3">
                                <TextBlock Text="RANK UP!" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" CharacterSpacing="100" />
                                <TextBlock x:Name="CompletionRankupValueText" Text="" FontSize="14" FontWeight="ExtraBold" Foreground="#C4B5FD" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnCompletionDismissTapped" AutomationProperties.Name="Close flight summary"
                            Tapped="OnCompletionDismissTapped" Background="#4D9BEC" CornerRadius="10" Padding="0,13" Margin="0,12,0,0">
                        <TextBlock Text="Dismiss" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" CharacterSpacing="30" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

    <!-- ── Booking activation gate ──
         Topmost sibling in the root Grid, so it fully replaces the page (opaque, matching the
         page background; not a translucent dim like CompletionOverlayGrid above, which docks a
         panel over live content) whenever the pilot has no activated booking. Checked fresh in
         OnPageLoaded every time this page is navigated to; there is no live re-check while this
         page stays open because activating only happens on Pilot Hub, a different page in this
         single-Frame shell, so the pilot always returns here by navigating back. The real "no
         tracking" enforcement is server-side of this UI gate; see
         FlightSessionManager.OnEnginesStarted's own comment. -->
    <Grid x:Name="BookingGateGrid" Background="#080B14" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
            <Viewbox Width="40" Height="40" Opacity="0.4" HorizontalAlignment="Center">
                <Path Data="M12 2 15 8l6 .9-4.5 4.3L17.5 20 12 17l-5.5 3 1-6.8L3 8.9 9 8z" Stroke="#64748B"
                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBlock Text="Activate a booking to access ACARS" FontFamily="{StaticResource DisplayFontBold}"
                       FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="BookingGateSubtitleText" FontSize="13" Foreground="#94A3B8"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </Grid>
</Page>
