<Page
    x:Class="AviatesAirTracker.Pages.FlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Flights.razor (dark theme
      values from wwwroot\css\app.css), hardcoded inline per the Phase 2/3 rule this project
      has followed for every prior native page: no Style element and no new Theme\Tokens.xaml
      entry may appear anywhere in this project's XAML, or XamlCompiler.exe silently crashes
      on this SDK. Every color/spacing value below is a direct property value, not a new
      resource (existing Theme\Tokens.xaml/Typography.xaml StaticResource lookups are fine to
      reuse, since those entries already exist).

      NOTE for future edits: XAML comments are plain XML comments, so a literal double hyphen
      anywhere inside one is invalid XML and crashes XamlCompiler.exe the same way the
      Style/resource issue above does; use a single hyphen, a semicolon, or a real box-drawing
      character (the section-header "──" below) instead.

      This task (Task 2) only builds the page skeleton, header, tab bar, and stat strip. The
      flight table (Task 3) and modals (Task 4) are added in later passes.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="Flights" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Your complete logbook: every flight recorded and scored."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Tab bar ──
                 Border-based active-state treatment, matching ShellWindow.xaml.cs's
                 ConfigureNavAppearance color convention for the nav rail's own active item
                 (SidebarActiveBrush background + SidebarTextActiveBrush text when selected),
                 not the same code, just the same visual idea applied to a different control.
                 All four tabs share one Tapped handler (OnTabTapped); which tab fired is read
                 from the Border's own Tag. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="TabAllBorder" Tag="all" Tapped="OnTabTapped"
                        CornerRadius="10" Padding="16,9">
                    <TextBlock x:Name="TabAllText" Text="All Flights" FontSize="13" FontWeight="SemiBold" />
                </Border>

                <Border x:Name="TabActiveBorder" Tag="active" Tapped="OnTabTapped"
                        CornerRadius="10" Padding="16,9">
                    <TextBlock x:Name="TabActiveText" Text="Active" FontSize="13" FontWeight="SemiBold" />
                </Border>

                <Border x:Name="TabCompletedBorder" Tag="completed" Tapped="OnTabTapped"
                        CornerRadius="10" Padding="16,9">
                    <TextBlock x:Name="TabCompletedText" Text="Completed" FontSize="13" FontWeight="SemiBold" />
                </Border>

                <Border x:Name="TabPendingBorder" Tag="pending" Tapped="OnTabTapped"
                        CornerRadius="10" Padding="16,9">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="TabPendingText" Text="Pending Review" FontSize="13" FontWeight="SemiBold" />
                        <!-- Live count badge: Flights.razor's own pill (background is the
                             app.css red token, white text, fully rounded). Count is set in
                             code-behind, filtered to Pending-status requests only (matching
                             Flights.razor's own badge exactly) since PendingRequests itself
                             holds every request regardless of status, same imperative-set
                             pattern PilotHubPage.xaml.cs already uses for RankSubText/etc. -->
                        <Border Background="#EF4444" CornerRadius="10" Padding="7,1" MinWidth="18"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PendingCountText" Text="0" FontSize="10" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Stat strip ──
                 Icons verified against Flights.razor's actual current markup, NOT assumed to
                 match Dashboard/Pilot Hub's own 3 icons; they don't: this page uses a
                 send-glyph (blue, Total Flights; same path Dashboard/PilotHub already use for
                 their own Flights-count stat), a checkmark (green, Completed; new to this
                 page, not reused from Dashboard's activity-zigzag or PilotHub's compass), and a
                 clock (amber, Total Distance; PilotHub uses the same clock glyph but in cyan
                 for its Hours stat; this page pairs it with amber instead). -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1F4D9BEC">
                            <Viewbox Width="20" Height="20">
                                <Path Data="M22 16.5L13 3l-2 4-5-1L2 9l5 2-1 3 4 1 1 5 5-3z"
                                      Stroke="#4D9BEC" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="TotalFlightsText" Text="0"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Total Flights" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1F3EC7AC">
                            <Viewbox Width="20" Height="20">
                                <Polyline Points="20,6 9,17 4,12" Stroke="#3EC7AC" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="CompletedFlightsText" Text="0"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Completed" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1FF59E0B">
                            <Viewbox Width="20" Height="20">
                                <Grid Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Stroke="#F59E0B" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Polyline Points="12,6 12,12 16,14" Stroke="#F59E0B" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,3">
                                <TextBlock x:Name="TotalDistanceText" Text="—"
                                           FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                           Foreground="#F1F5F9" />
                                <TextBlock x:Name="TotalDistanceUnitText" Text=" nm" FontSize="13"
                                           Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,3"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Text="Total Distance" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Flight Logbook table ──
                 Flights.razor's .data-table-wrap/.data-table, reproduced as a Grid-per-row
                 ItemsControl since WinUI has no table equivalent; same technique
                 PilotHubPage.xaml's Landing History table already established (header Grid and
                 each row's Grid share identical star-weighted ColumnDefinitions so the two line
                 up). The per-row view-details icon stays visual-only (no destination page exists
                 yet); delete/force-remove are wired below. -->
            <Border x:Name="FlightLogbookBorder" Background="#0C111D" BorderBrush="#14FFFFFF"
                    BorderThickness="1" CornerRadius="20">
                <StackPanel>
                    <!-- Header strip: title + Filter (Export removed, was never wired to anything) -->
                    <Grid Padding="20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                                VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="0" Text="Flight Logbook" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <!-- Filter: opens a ContentDialog (search text + aircraft type), same
                                 dialog pattern as the delete/force-remove/settings dialogs elsewhere
                                 in this page and app; WinUI's Flyout is untested anywhere in this
                                 project, ContentDialog is proven safe on this exact page. -->
                            <Border x:Name="FilterBorder" Tag="filter" Tapped="OnFilterTapped"
                                    Background="#121A2A" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="13" Height="13">
                                        <Path Data="M3 6h18M6 12h12M9 18h6" Stroke="#CBD5E1" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                    <TextBlock Text="Filter" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <!-- Active-filter count badge, same visual language as the
                                         Pending Review tab's count pill above; hidden at 0. -->
                                    <Border x:Name="FilterCountBadge" Background="#4D9BEC" CornerRadius="10"
                                            Padding="7,1" MinWidth="18" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="FilterCountText" Text="0" FontSize="10" FontWeight="Bold"
                                                   Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Empty state: shown when the active tab's filtered flight list is empty.
                         Base copy is an exact copy from Flights.razor's "No flights yet" panel;
                         title/subtitle text is swapped in code-behind when the empty result is
                         caused by an active Filter rather than a genuinely empty logbook. -->
                    <StackPanel x:Name="EmptyStateText" Visibility="Collapsed" Padding="24,64" Spacing="16">
                        <Viewbox Width="40" Height="40" Opacity="0.4">
                            <Path Data="M22 16.5L13 3l-2 4-5-1L2 9l5 2-1 3 4 1 1 5 5-3z" Stroke="#64748B"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyStateTitle" Text="No flights yet" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#CBD5E1" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateSubtitle" Text="Connect MSFS and start your engines to begin recording."
                                       FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="FlightsTableContent">
                        <!-- Header row -->
                        <Grid Padding="20,17" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="7" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="FLIGHT" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="ROUTE" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="2" Text="AIRCRAFT" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="3" Text="DURATION" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="4" Text="LANDING" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="6" Text="ACTION" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                        </Grid>

                        <ItemsControl x:Name="FlightsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,19" ColumnSpacing="12" Opacity="{Binding RowOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="7" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1"
                                                VerticalAlignment="Bottom" />

                                        <!-- Flight -->
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FlightNumber}" FontFamily="{StaticResource DisplayFontBold}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>

                                        <!-- Route: two small flag icons + mono route label -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center" ToolTipService.ToolTip="{Binding RouteTooltip}">
                                            <Image Source="{Binding DepartureFlagSource}" Width="18" Height="13" Stretch="UniformToFill" />
                                            <Image Source="{Binding ArrivalFlagSource}" Width="18" Height="13" Stretch="UniformToFill" />
                                            <TextBlock Text="{Binding RouteLabel}" FontFamily="{StaticResource DisplayFontBold}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding AircraftType}" FontSize="13"
                                                   Foreground="#CBD5E1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="12"
                                                   Foreground="#CBD5E1" VerticalAlignment="Center" />

                                        <!-- Landing: grade chip, or plain muted "—" when no landing (see
                                             FlightLogRow.GradeChipText's doc comment) -->
                                        <Border Grid.Column="4" Background="{Binding GradeChipBackground}"
                                                CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GradeChipText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding GradeChipColor}" />
                                        </Border>

                                        <!-- Status chip -->
                                        <Border Grid.Column="5" Background="{Binding StatusChipBackground}"
                                                CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusChipColor}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusChipColor}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action: view-details chevron (always shown, inert), delete
                                             (Status != InProgress and no open deletion request), and
                                             force-remove (Status == InProgress); all icons visual-only
                                             here, Task 4 wires their Tapped handlers. -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="999" Background="#121A2A"
                                                    BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                <Viewbox Width="11" Height="11">
                                                    <Path Data="M9 18l6-6-6-6" Stroke="#CBD5E1" StrokeThickness="2.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </Border>
                                            <Border Width="26" Height="26" CornerRadius="999" Background="#121A2A"
                                                    BorderBrush="#4DEF4444" BorderThickness="1"
                                                    Visibility="{Binding ShowDeleteAction}"
                                                    Tag="{Binding}" Tapped="OnDeleteActionTapped"
                                                    ToolTipService.ToolTip="Request deletion">
                                                <Viewbox Width="11" Height="11">
                                                    <Path Data="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"
                                                          Stroke="#EF4444" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </Border>
                                            <Border Width="26" Height="26" CornerRadius="999" Background="#121A2A"
                                                    BorderBrush="#4DEF4444" BorderThickness="1"
                                                    Visibility="{Binding ShowForceRemoveAction}"
                                                    Tag="{Binding}" Tapped="OnForceRemoveActionTapped"
                                                    ToolTipService.ToolTip="Force remove broken flight">
                                                <Viewbox Width="11" Height="11">
                                                    <Path Data="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"
                                                          Stroke="#EF4444" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Deletion Requests table (Pending Review tab) ──
                 Flights.razor's own top-level @if (_activeTab == "pending") branch: a distinct
                 table from the Flight Logbook above, shown instead of it (not alongside), listing
                 every deletion request regardless of status (open ones get Approve/Reject
                 buttons; already-resolved ones show their reviewed-at timestamp instead; see
                 DeletionRequestRow.ShowActions/ShowReviewedText). Visibility toggled in
                 RefreshActiveTabContent, same technique as FlightLogbookBorder's own toggle. -->
            <Border x:Name="DeletionRequestsBorder" Background="#0C111D" BorderBrush="#14FFFFFF"
                    BorderThickness="1" CornerRadius="20" Visibility="Collapsed">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                                VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Deletion Requests" FontFamily="{StaticResource DisplayFontBold}"
                                       FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                            <TextBlock Text="Requests require approval before a flight is permanently removed"
                                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Empty state: exact copy from Flights.razor's "No deletion requests found." panel -->
                    <StackPanel x:Name="DeletionRequestsEmptyText" Visibility="Collapsed" Padding="24,48">
                        <TextBlock Text="No deletion requests found." FontSize="13" Foreground="#64748B"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="DeletionRequestsTableContent">
                        <!-- Header row -->
                        <Grid Padding="20,17" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="6" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="FLIGHT" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="ROUTE" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="2" Text="REASON" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="3" Text="SUBMITTED" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="5" Text="ACTION" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                        </Grid>

                        <ItemsControl x:Name="DeletionRequestsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,19" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="6" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1"
                                                VerticalAlignment="Bottom" />

                                        <TextBlock Grid.Column="0" Text="{Binding FlightNumber}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding Route}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" FontSize="12"
                                                   Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="{Binding SubmittedText}" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center" />

                                        <Border Grid.Column="4" Background="{Binding StatusBackground}"
                                                CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColor}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action: Approve/Reject buttons when still Pending, else the
                                             reviewed-at timestamp; mutually exclusive, matching
                                             Flights.razor's own @if (req.Status == Pending) branch. -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center" Visibility="{Binding ShowActions}">
                                            <Border Background="#1A22C55E" BorderBrush="#6622C55E" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,4"
                                                    Tag="{Binding}" Tapped="OnApproveTapped">
                                                <TextBlock Text="Approve" FontSize="11" FontWeight="Bold" Foreground="#22C55E" />
                                            </Border>
                                            <Border Background="#1FEF4444" BorderBrush="#66EF4444" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,4"
                                                    Tag="{Binding}" Tapped="OnRejectTapped">
                                                <TextBlock Text="Reject" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="5" Text="{Binding ReviewedText}" FontSize="11"
                                                    Foreground="#64748B" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowReviewedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
