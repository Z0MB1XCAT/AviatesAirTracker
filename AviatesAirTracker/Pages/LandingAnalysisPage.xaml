<Page
    x:Class="AviatesAirTracker.Pages.LandingAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Landing Analysis: every recorded landing on the left, the full debrief of the selected one
      on the right. The detail column is built in code (LandingAnalysisPage.xaml.cs) from the
      shared LandingReport, the same way LandingResultDialog builds the touchdown pop-up, since
      its sections and charts depend on which data the landing has.

      Same rules as every page here: no Style elements, no new Tokens.xaml entries, and no double
      hyphen inside a comment (each silently crashes XamlCompiler.exe on this SDK).
    -->

    <Grid Padding="32,28,0,0" ColumnSpacing="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Landing list ── -->
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Landings" FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                           CharacterSpacing="-30" Foreground="#F1F5F9" />
                <TextBlock x:Name="LandingCountText" Text="Every touchdown, debriefed."
                           FontSize="13" Foreground="#94A3B8" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24">
                <StackPanel x:Name="LandingListHost" Spacing="6" />
            </ScrollViewer>
        </Grid>

        <!-- ── Selected landing ── -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,32,32">
            <Grid>
                <StackPanel x:Name="DetailHost" MaxWidth="1100" Spacing="20" HorizontalAlignment="Stretch" />
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="8" Padding="0,120,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="No landings yet" FontFamily="{StaticResource DisplayFontBold}" FontSize="18"
                               Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="Fly a booked flight and your first touchdown will be analysed here."
                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
