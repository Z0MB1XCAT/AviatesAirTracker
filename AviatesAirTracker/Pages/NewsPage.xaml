<Page
    x:Class="AviatesAirTracker.Pages.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Backed by NewsViewModel/the real news_articles table (via AviatesBackendClient.
      FetchNewsAsync's public GET /api/news), following the same Phase 2/3 rules every native
      page in this project follows: no Style element and no new Theme\Tokens.xaml entry may
      appear anywhere in this project's XAML (silently crashes XamlCompiler.exe on this SDK,
      zero diagnostics), and no literal double hyphen inside any XAML comment (invalid XML, same
      silent crash; use a single hyphen or the box-drawing "──" character instead).

      The filter tab bar (All News/Operations/Fleet/Community/Events) was removed; it was
      always purely cosmetic (none of the 5 tabs ever filtered anything, matching News.razor's
      own dead markup), and wasn't worth keeping once real, clickable articles replaced the
      hardcoded cards. A responsive card grid (RoutesPage.xaml.cs's ItemsWrapGrid/SizeChanged
      column-recompute technique, ported to avoid the dead-gap-on-resize bug that fix was
      created for) shows each article's real thumbnail (NewsPage.xaml.cs's LoadRemoteImage
      resolves news_articles' root-relative /images/... paths against the main flyaviatesair.uk
      site, the same host the AviatesAir website itself resolves them against) or a gradient
      fallback if there's none. The whole card is Tapped-wired (OnCardTapped) to navigate to the
      new NewsDetailPage with the full article; the "Read" link has no handler of its own and
      relies on Tapped bubbling up to the card.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="News &amp; Announcements" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" FontWeight="Bold" Foreground="#F1F5F9" />
                <TextBlock Text="Stay up to date with AviatesAir operations, fleet updates, and community news."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <TextBlock x:Name="EmptyNewsText" Text="No news articles available right now. Check back soon."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Padding="0,48" Visibility="Collapsed" />

            <!-- ── News card grid ──
                 ItemsWrapGrid wraps cards into rows; ItemWidth is recomputed in code-behind
                 (UpdateNewsGridColumns) from the panel's own ActualWidth so columns stretch to
                 fill the available width instead of leaving a dead gap when it doesn't divide
                 evenly by a fixed card width ── same technique RoutesPage.xaml/.xaml.cs
                 established. Each card is HorizontalAlignment="Stretch" so it fills its
                 ItemWidth cell (minus the right/bottom gutter margin). -->
            <ItemsControl x:Name="NewsCardsList" SizeChanged="NewsCardsList_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="Stretch" Margin="0,0,16,16" Background="#0C111D"
                                BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20"
                                Tag="{Binding}" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnCardTapped" AutomationProperties.Name="Read article"
                                                Tapped="OnCardTapped">
                            <StackPanel>

                                <!-- Banner: photo (2 cards) OR gradient + low-opacity emoji (4 cards),
                                     layered in the same Grid so the Border's own CornerRadius clips
                                     whichever is visible to the card's rounded top corners
                                     (WinUI Border clips its child to CornerRadius automatically,
                                     same as FleetPage.xaml's photo/gradient-placeholder Grid). -->
                                <Grid Height="160">
                                    <Image Source="{Binding PhotoSource}" Visibility="{Binding ShowPhoto}"
                                           Stretch="UniformToFill" />
                                    <Border Visibility="{Binding ShowGradient}" Background="{Binding GradientBrush}" />

                                    <!-- Tag chip, top-left corner -->
                                    <Border Background="#1FFFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="10,4" Margin="14"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding TagDisplay}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#E6FFFFFF" CharacterSpacing="100" />
                                    </Border>

                                    <!-- Date chip, bottom-right corner -->
                                    <Border Background="#66000000" CornerRadius="8" Padding="8,4" Margin="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#CCFFFFFF" />
                                    </Border>
                                </Grid>

                                <!-- Body -->
                                <StackPanel Padding="16" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFontBold}"
                                               FontSize="15" FontWeight="Bold" Foreground="#F1F5F9"
                                               TextWrapping="Wrap" LineHeight="20" />
                                    <TextBlock Text="{Binding Excerpt}" FontSize="12.5" Foreground="#64748B"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               LineHeight="19" Margin="0,0,0,4" />

                                    <Border Height="1" Background="#0DFFFFFF" Margin="0,0,0,8" />

                                    <!-- Footer: "Read" link. No author avatar/name here anymore;
                                         news_articles has no author column, unlike the old
                                         hardcoded cards' invented Zakir/Padhang/Leonardo bylines. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- No Tapped handler of its own: Tapped bubbles up to the whole
                                             card's own OnCardTapped above, so clicking "Read" navigates to
                                             the full article the same as clicking anywhere else on the card. -->
                                        <Border Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="Read" FontSize="12" FontWeight="Bold" Foreground="#4D9BEC" />
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M5 12h14M12 5l7 7-7 7" Stroke="#4D9BEC" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
