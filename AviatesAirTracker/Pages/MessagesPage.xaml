<Page
    x:Class="AviatesAirTracker.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Messages.razor, following the same
      Phase 2/3 rules every prior native page in this migration has followed: no Style element
      and no new Theme\Tokens.xaml entry may appear anywhere in this project's XAML (silently
      crashes XamlCompiler.exe on this SDK), and no literal double hyphen inside any XAML comment
      (invalid XML, same silent crash) - use a single hyphen or the box-drawing "──" character
      instead. Every color/spacing value below is a direct property value, taken from
      wwwroot/css/app.css's html[data-theme="dark"] token block (the same hex values every prior
      native page hardcodes): surface #0C111D, surface-2 #121A2A, border rgba(255,255,255,0.08),
      text-primary #F1F5F9, text-muted #64748B, accent #4D9BEC, accent-light rgba(77,155,236,0.12),
      violet #B8934A, red #EF4444, red-light rgba(239,68,68,0.10).

      This task (Task 2) builds the page skeleton, the ACARS-key gate, the tab bar, and a fully
      functional Inbox tab (friend list + conversation + compose + bubble-in animation). The
      Broadcast and Friends tabs are stub placeholders here - Task 3 builds them out, reusing the
      Inbox tab's bubble-building code-behind helper rather than duplicating it.

      Icon reproduction note: several original SVG icons use elliptical-arc path commands with
      SVG's compact flag shorthand (e.g. "a4 4 0 00-8 0v4"), which is ambiguous for WinUI's Path
      Markup Syntax parser without explicit separators. Every Path.Data value below is the same
      icon fully expanded to comma-separated absolute coordinates and single-digit arc flags
      (e.g. "A4,4,0,0,0,8,7") so it parses unambiguously - not a simplification, the same glyph,
      just spelled out explicitly.

      The bubble list (friend conversation) is built entirely in code-behind (BubbleListPanel's
      Children are populated imperatively in MessagesPage.xaml.cs), not via ItemsControl/
      DataTemplate binding - this is deliberate: the bubble-in Storyboard animation needs to
      selectively animate only newly-added bubbles on each rebuild, which is far simpler to track
      against a HashSet of already-seen message ids when the page owns Border-element creation
      directly, rather than fighting ItemsControl's container-recycling behavior.
    -->

    <Grid Padding="32">

        <!-- ── Page header ── Always visible, even behind the ACARS gate (matches Messages.razor's
             own page-header markup living outside its `@if (!_hasAcarsKey)` block). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Messages" FontFamily="{StaticResource DisplayFontBold}"
                       FontSize="26" Foreground="#F1F5F9" />
            <TextBlock Text="Communicate with other AviatesAir pilots. All messages are moderated and tied to your ACARS key."
                       FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- ── ACARS-key gate ──
                 Replaces everything below the header with a single empty state when
                 !HasAcarsKey (matches Messages.razor's `@if (!_hasAcarsKey)` branch exactly - no
                 tabs, no panels render at all in this state). The native SettingsPage doesn't
                 exist yet (see the design spec's explicit scoping), so the CTA below is a
                 deliberate no-op for now - see OnGoToSettingsTapped's comment in the code-behind. -->
            <StackPanel x:Name="AcarsGatePanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16" MaxWidth="420" Padding="0,60">
                <Viewbox Width="44" Height="44" Opacity="0.45" HorizontalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Rectangle Width="18" Height="11" RadiusX="2" RadiusY="2"
                                   Stroke="#94A3B8" StrokeThickness="1.8"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        <Path Data="M7,11 V7 A5,5,0,0,1,17,7 V11"
                              Stroke="#94A3B8" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="ACARS Key Required" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="18" FontWeight="Bold" Foreground="#F1F5F9"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Configure your ACARS key in Settings to use the messaging system."
                           FontSize="13.5" Foreground="#94A3B8" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <!-- Task 5's spec explicitly leaves this disabled/no-op until the native
                     SettingsPage exists (a future, separate conversion) - see OnGoToSettingsTapped. -->
                <Border Tag="settings" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnGoToSettingsTapped" AutomationProperties.Name="Go to Settings"
                                       Tapped="OnGoToSettingsTapped" Background="#4D9BEC"
                        CornerRadius="10" Padding="20,10" HorizontalAlignment="Center">
                    <TextBlock Text="Go to Settings" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>
            </StackPanel>

            <!-- ── Main content (tab bar + tab panels) ── -->
            <Grid x:Name="MainContentGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab bar: same Border-active-state technique every prior page uses. -->
                <Border Grid.Row="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border x:Name="TabInboxBorder" Tag="inbox" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnTabTapped" AutomationProperties.Name="Inbox"
                                                                    Tapped="OnTabTapped" CornerRadius="10" Padding="18,9">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="TabInboxText" Text="Inbox" FontSize="13.5" FontWeight="SemiBold" />
                                <Border x:Name="TabInboxBadgeBorder" Background="#FFFFFF" CornerRadius="10"
                                        Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="TabInboxBadgeText" FontSize="10" FontWeight="Bold" Foreground="#4D9BEC" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TabBroadcastBorder" Tag="broadcast" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnTabTapped" AutomationProperties.Name="Broadcast"
                                                                            Tapped="OnTabTapped" CornerRadius="10" Padding="18,9">
                            <TextBlock x:Name="TabBroadcastText" Text="Broadcast" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="TabFriendsBorder" Tag="friends" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnTabTapped" AutomationProperties.Name="Friends"
                                                                        Tapped="OnTabTapped" CornerRadius="10" Padding="18,9">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="TabFriendsText" Text="Friends" FontSize="13.5" FontWeight="SemiBold" />
                                <Border x:Name="TabFriendsBadgeBorder" Background="#121A2A" CornerRadius="10"
                                        Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="TabFriendsBadgeText" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tab panels: mutually exclusive via Visibility, all sharing the same grid cell. -->
                <Grid Grid.Row="1">

                    <!-- ── INBOX TAB ── -->
                    <Grid x:Name="InboxPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Friend list (left column) -->
                        <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="DIRECT MESSAGES" FontSize="11" FontWeight="Bold"
                                           CharacterSpacing="24" Foreground="#64748B" Padding="16,14,16,10" />

                                <Grid Grid.Row="1">
                                    <StackPanel x:Name="FriendListEmptyPanel" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="10" Padding="16">
                                        <Viewbox Width="22" Height="22" Opacity="0.4" HorizontalAlignment="Center">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Width="8" Height="8" Stroke="#64748B" StrokeThickness="1.8"
                                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                <Path Data="M3,21 V19 A4,4,0,0,1,7,15 H11 A4,4,0,0,1,15,19 V21"
                                                      Stroke="#64748B" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                <Path Data="M16,11 L18,13 L22,9"
                                                      Stroke="#64748B" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="Add friends to send direct messages" FontSize="12.5"
                                                   Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>

                                    <ScrollViewer x:Name="FriendListScroll" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="FriendListItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Tag="{Binding}" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnFriendTapped" AutomationProperties.Name="Open conversation"
                                                                            Tapped="OnFriendTapped"
                                                            Background="{Binding RowBackground}" Padding="16,10">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#4D9BEC" Offset="0" />
                                                                        <GradientStop Color="#B8934A" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFontBold}"
                                                                           FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" MinWidth="0">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Rank}" FontSize="11" Foreground="#64748B" />
                                                            </StackPanel>

                                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#4D9BEC"
                                                                     VerticalAlignment="Center" Visibility="{Binding ShowUnreadDot}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Conversation panel (right column) -->
                        <Border Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <StackPanel x:Name="ConversationEmptyPanel" Visibility="Visible"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <Viewbox Width="36" Height="36" Opacity="0.3" HorizontalAlignment="Center">
                                        <Grid Width="24" Height="24">
                                            <Path Data="M21,15 A2,2,0,0,1,19,17 H7 L3,21 V5 A2,2,0,0,1,5,3 H19 A2,2,0,0,1,21,5 Z"
                                                  Stroke="#64748B" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="Select a friend to start a conversation" FontSize="13.5" Foreground="#64748B" />
                                </StackPanel>

                                <Grid x:Name="ConversationContentGrid" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Border Grid.Row="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4D9BEC" Offset="0" />
                                                        <GradientStop Color="#B8934A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock x:Name="ConvAvatarText" FontSize="11" FontWeight="Bold"
                                                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="ConvNameText" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" />
                                                <TextBlock x:Name="ConvRankText" FontSize="11.5" Foreground="#64748B" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Tag="remove" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRemoveFriendTapped" AutomationProperties.Name="Remove friend"
                                                                                 Tapped="OnRemoveFriendTapped"
                                                    CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Viewbox Width="12" Height="12">
                                                        <Grid Width="24" Height="24">
                                                            <Path Data="M16,11 V7 A4,4,0,0,0,8,7 V11 M5,9 H19 L20,21 H4 L5,9 Z"
                                                                  Stroke="#64748B" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                        </Grid>
                                                    </Viewbox>
                                                    <TextBlock Text="Remove" FontSize="12" Foreground="#64748B" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Bubble list -->
                                    <ScrollViewer Grid.Row="1" x:Name="BubbleListScroll" VerticalScrollBarVisibility="Auto" Padding="16">
                                        <StackPanel x:Name="BubbleListPanel" Spacing="12" />
                                    </ScrollViewer>

                                    <!-- Inline send-error banner -->
                                    <Border Grid.Row="2" x:Name="DmSendErrorBorder" Visibility="Collapsed"
                                            Background="#1AEF4444" BorderBrush="#2EEF4444" BorderThickness="0,1,0,0" Padding="16,9">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Viewbox Width="14" Height="14">
                                                <Grid Width="24" Height="24">
                                                    <Ellipse Width="20" Height="20" Stroke="#EF4444" StrokeThickness="2"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Line X1="12" Y1="8" X2="12" Y2="12" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                    <Line X1="12" Y1="16" X2="12" Y2="16.01" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock x:Name="DmSendErrorText" FontSize="12.5" FontWeight="Medium"
                                                       Foreground="#EF4444" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Compose row -->
                                    <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                                            <TextBox x:Name="ComposeTextBox" PlaceholderText="Type a message..." MaxLength="500"
                                                     Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                     Padding="18,10" VerticalAlignment="Center"
                                                     KeyDown="OnComposeKeyDown" TextChanged="OnComposeTextChanged" />
                                        </Border>

                                        <Border Grid.Column="1" x:Name="SendButtonBorder" Tag="send" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnSendDirectTapped" AutomationProperties.Name="Send message"
                                                                                                     Tapped="OnSendDirectTapped"
                                                Width="42" Height="42" CornerRadius="21" Background="#4D9BEC" Opacity="0.45">
                                            <Grid>
                                                <Viewbox x:Name="SendIconViewbox" Width="18" Height="18">
                                                    <Grid Width="24" Height="24">
                                                        <Line X1="22" Y1="2" X2="11" Y2="13" Stroke="#FFFFFF" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <Polygon Points="22,2 15,22 11,13 2,9" Stroke="#FFFFFF" StrokeThickness="2"
                                                                 StrokeLineJoin="Round" />
                                                    </Grid>
                                                </Viewbox>
                                                <ProgressRing x:Name="SendProgressRing" IsActive="False" Visibility="Collapsed"
                                                              Width="18" Height="18" Foreground="#FFFFFF" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── BROADCAST TAB ──
                         Single-column public feed. Reuses Inbox's exact RebuildBubbleList/BuildBubble
                         code-behind helpers (isBroadcast: true) so the bubble-in Storyboard animation
                         applies here too, per the design spec's "both tabs, don't skip it". -->
                    <Grid x:Name="BroadcastPanel" Visibility="Collapsed">
                        <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="AviatesAir Pilot Channel" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <Border Background="#1F3EC7AC" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="Public" FontSize="10" FontWeight="Bold" Foreground="#3EC7AC" CharacterSpacing="24" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Bubble list -->
                                <ScrollViewer Grid.Row="1" x:Name="BroadcastBubbleListScroll" VerticalScrollBarVisibility="Auto" Padding="16">
                                    <StackPanel x:Name="BroadcastBubbleListPanel" Spacing="12" />
                                </ScrollViewer>

                                <!-- Inline send-error banner -->
                                <Border Grid.Row="2" x:Name="BroadcastSendErrorBorder" Visibility="Collapsed"
                                        Background="#1AEF4444" BorderBrush="#2EEF4444" BorderThickness="0,1,0,0" Padding="16,9">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Viewbox Width="14" Height="14">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Width="20" Height="20" Stroke="#EF4444" StrokeThickness="2"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Line X1="12" Y1="8" X2="12" Y2="12" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="12" Y1="16" X2="12" Y2="16.01" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="BroadcastSendErrorText" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="#EF4444" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Compose row (280-char max, unlike Inbox's 500) -->
                                <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                                        <TextBox x:Name="BroadcastComposeTextBox" PlaceholderText="Broadcast to all pilots..." MaxLength="280"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="18,10" VerticalAlignment="Center"
                                                 KeyDown="OnBroadcastComposeKeyDown" TextChanged="OnBroadcastComposeTextChanged" />
                                    </Border>

                                    <Border Grid.Column="1" x:Name="BroadcastSendButtonBorder" Tag="send" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnSendBroadcastTapped" AutomationProperties.Name="Send broadcast"
                                                                                                          Tapped="OnSendBroadcastTapped"
                                            Width="42" Height="42" CornerRadius="21" Background="#4D9BEC" Opacity="0.45">
                                        <Grid>
                                            <Viewbox x:Name="BroadcastSendIconViewbox" Width="18" Height="18">
                                                <Grid Width="24" Height="24">
                                                    <Line X1="22" Y1="2" X2="11" Y2="13" Stroke="#FFFFFF" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Polygon Points="22,2 15,22 11,13 2,9" Stroke="#FFFFFF" StrokeThickness="2"
                                                             StrokeLineJoin="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <ProgressRing x:Name="BroadcastSendProgressRing" IsActive="False" Visibility="Collapsed"
                                                          Width="18" Height="18" Foreground="#FFFFFF" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── FRIENDS TAB ──
                         Two side-by-side cards: "Add a Pilot" (friend-code lookup form) and
                         "Your Crew" (the friends list, also usable to jump into the Inbox tab). -->
                    <Grid x:Name="FriendsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- "Add a Pilot" card -->
                        <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="20" Padding="20" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Add a Pilot" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" />
                                <TextBlock Text="Ask another pilot for their Friend Code (found in their Settings page) and enter it below."
                                           FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="20" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="FRIEND CODE" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="20" />
                                    <Border Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="FriendCodeTextBox" PlaceholderText="e.g. K4MR-B7WN" MaxLength="9"
                                                 CharacterCasing="Upper" FontFamily="Consolas" CharacterSpacing="60"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" TextChanged="OnFriendCodeTextChanged" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="PILOT NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="20" />
                                    <Border Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="FriendNameTextBox" PlaceholderText="Their name (used if lookup is offline)" MaxLength="60"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" />
                                    </Border>
                                </StackPanel>

                                <Border x:Name="AddFriendStatusBorder" Visibility="Collapsed" CornerRadius="10" Padding="14,9">
                                    <TextBlock x:Name="AddFriendStatusText" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                                </Border>

                                <Border x:Name="AddFriendButtonBorder" Tag="add" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnAddFriendTapped" AutomationProperties.Name="Add Pilot"
                                                                                 Tapped="OnAddFriendTapped"
                                        Background="#4D9BEC" CornerRadius="10" Padding="0,12" Opacity="0.45">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Viewbox x:Name="AddFriendIconViewbox" Width="15" Height="15">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Width="8" Height="8" Stroke="#FFFFFF" StrokeThickness="1.8"
                                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                <Path Data="M3,21 V19 A4,4,0,0,1,7,15 H11 A4,4,0,0,1,15,19 V21"
                                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                <Line X1="19" Y1="8" X2="19" Y2="14" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                                <Line X1="16" Y1="11" X2="22" Y2="11" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <ProgressRing x:Name="AddFriendProgressRing" IsActive="False" Visibility="Collapsed"
                                                      Width="15" Height="15" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="AddFriendButtonText" Text="Add Pilot" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- "Your Crew" card -->
                        <Border Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="20" Padding="20" VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="CrewTitleText" Text="Your Crew: 0 pilots" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" />

                                <StackPanel x:Name="CrewEmptyPanel" Visibility="Collapsed" Spacing="4" Padding="0,28" HorizontalAlignment="Center">
                                    <TextBlock Text="No friends added yet." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                                    <TextBlock Text="Enter a Friend Code to get started." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl x:Name="CrewListItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#4D9BEC" Offset="0" />
                                                                <GradientStop Color="#B8934A" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" MinWidth="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SubText}" FontSize="11.5" Foreground="#64748B"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Tag="{Binding}" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnMessageFriendTapped" AutomationProperties.Name="Message friend"
                                                                                            Tapped="OnMessageFriendTapped"
                                                            Background="#1A4D9BEC" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                        <TextBlock Text="Message" FontSize="12" FontWeight="SemiBold" Foreground="#4D9BEC" />
                                                    </Border>

                                                    <Border Grid.Column="3" Tag="{Binding}" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRemoveCrewFriendTapped" AutomationProperties.Name="Remove friend"
                                                                                            Tapped="OnRemoveCrewFriendTapped"
                                                            Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center">
                                                        <Viewbox Width="14" Height="14">
                                                            <Grid Width="24" Height="24">
                                                                <Polyline Points="3,6 5,6 21,6" Stroke="#64748B" StrokeThickness="2"
                                                                          StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                                <Path Data="M19,6 L18,20 H6 L5,6" Stroke="#64748B" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                                <Path Data="M10,11 V17 M14,11 V17 M9,6 V4 H15 V6" Stroke="#64748B" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                                            </Grid>
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
