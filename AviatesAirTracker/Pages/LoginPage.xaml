<Page
    x:Class="AviatesAirTracker.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0A0D17">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Login.razor ── the final page
      conversion in this migration (see docs/superpowers/specs/2026-08-27-native-login-page-design.md).
      Same rules every prior native page in this migration follows: no Style element anywhere
      (silently crashes XamlCompiler.exe on this SDK, zero diagnostics), no literal double-hyphen
      inside any XAML comment (invalid XML, same silent crash ── a single hyphen or the box-drawing
      "──" character is used instead), no malformed hex color literal (anything other than 3/6/8 hex
      digits after '#' builds clean but throws XamlParseException at runtime), and no Button anywhere
      (Border + Tapped for every clickable element instead).

      Layout: fixed-width (460px) left panel holding the sign-in UI over a subtle vertical gradient,
      remaining width filled by a looping muted background video (Microsoft.UI.Xaml.Controls.
      MediaPlayerElement, sourced in code-behind only when wwwroot/videos/login-bg.mp4 actually
      exists on disk ── see LoginPage.xaml.cs's constructor). When that file is absent (the expected
      state right now ── the user is recording it separately, in parallel with this build) a static
      layered-gradient fallback (FallbackBgGrid below) fills the same region instead, so the page
      still looks intentional and finished either way. A narrow gradient scrim blends the seam
      between the two columns; the rest of the video/fallback stays clearly visible, not washed out
      under a heavy full-bleed scrim (unlike Login.razor's own .login-bg-scrim over its static hero
      image).

      Signature "clearance strip": a slim Consolas status readout (ClearanceStripText below) cycling
      through the same four states Login.razor's _loading/_success/_errorMessage state machine
      already drives, voiced in ATC/dispatch phrasing ── see LoginPage.xaml.cs's UpdateVisualState.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════ Left panel: sign-in UI ══════════════════════════ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A0D17" Offset="0.0" />
                    <GradientStop Color="#0C111D" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid x:Name="LeftContentGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand mark ── Source set in code-behind from an absolute file path (wwwroot
                     ships as loose Content next to the exe, not a packaged ms-appx:// asset; same
                     technique as DashboardPage.xaml.cs's hero.webp). -->
                <Image x:Name="BrandLogoImage" Grid.Row="0"
                       Height="26" HorizontalAlignment="Left" Margin="48,40,48,0" Stretch="Uniform" />

                <!-- Headline + form, vertically centered -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0,48,0" Spacing="0">

                    <TextBlock FontFamily="{StaticResource DisplayFontBold}" FontSize="32"
                               Foreground="#F1F5F9" LineHeight="36" Margin="0,0,0,14">
                        <Run Text="Welcome Aboard," /><LineBreak /><Run Text="Pilot." />
                    </TextBlock>

                    <TextBlock FontFamily="{StaticResource BodyFontMedium}" FontSize="14"
                               Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,32">
                        Enter your ACARS key to access the operations centre. You can find it in
                        your pilot dashboard at flyaviatesair.uk.
                    </TextBlock>

                    <TextBlock Text="ACARS KEY" FontFamily="{StaticResource BodyFontBold}" FontSize="10.5"
                               Foreground="#64748B" CharacterSpacing="80" Margin="0,0,0,8" />

                    <!-- Input row: ACARS key TextBox + Paste chip -->
                    <Border x:Name="AcarsKeyInputBorder" Background="#0C111D" BorderThickness="1.5"
                            CornerRadius="14" Margin="0,0,0,8">
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="AcarsKeyInputBorderBrush" Color="#1EFFFFFF" />
                        </Border.BorderBrush>
                        <Grid ColumnSpacing="8" Margin="16,4,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AcarsKeyTextBox" Grid.Column="0"
                                     PlaceholderText="Paste your 28-character ACARS key"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource BodyFontMedium}" FontSize="13.5"
                                     Foreground="#F1F5F9" MaxLength="42"
                                     IsSpellCheckEnabled="False" VerticalAlignment="Center"
                                     KeyDown="OnAcarsKeyTextBoxKeyDown" TextChanged="OnAcarsKeyTextChanged" />

                            <Border x:Name="PasteButtonBorder" Grid.Column="1" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnPasteTapped" AutomationProperties.Name="Paste"
                                                                               Tapped="OnPasteTapped"
                                    Background="#14FFFFFF" CornerRadius="10" Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Paste" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Error area ── reserved space, matching Login.razor's always-rendered error div -->
                    <Grid MinHeight="30" Margin="4,4,0,10">
                        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                            <Ellipse Width="5" Height="5" Fill="#EF4444" Margin="0,2,0,0" />
                            <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="#EF4444"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- CTA -->
                    <Border x:Name="ConnectButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnConnectTapped" AutomationProperties.Name="Connect to AviatesAir"
                                                         Tapped="OnConnectTapped"
                            Background="#4D9BEC" CornerRadius="10" Padding="0,13" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <ProgressRing x:Name="ConnectSpinner" IsActive="False" Width="15" Height="15"
                                          Foreground="White" Visibility="Collapsed" />
                            <TextBlock x:Name="ConnectCheckText" Text="✓" FontSize="14" FontWeight="Bold"
                                       Foreground="White" Visibility="Collapsed" />
                            <TextBlock x:Name="ConnectButtonText" Text="Connect to AviatesAir"
                                       FontFamily="{StaticResource BodyFontBold}" FontSize="13.5" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!-- Signature "clearance strip" status readout -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="ClearanceStripDot" Width="6" Height="6" Fill="#64748B" />
                            <TextBlock x:Name="ClearanceStripText" Text="STATUS: AWAITING CLEARANCE"
                                       FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#64748B" CharacterSpacing="30" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" x:Name="RegisterLinkBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnRegisterTapped" AutomationProperties.Name="Register"
                                                                 Tapped="OnRegisterTapped"
                        Margin="48,0,48,32" HorizontalAlignment="Left" Padding="0,4">
                    <TextBlock FontFamily="{StaticResource BodyFontMedium}" FontSize="12.5" TextWrapping="Wrap">
                        <Run Text="New pilot? " Foreground="#64748B" /><Run Text="Register at flyaviatesair.uk" Foreground="#4D9BEC" />
                    </TextBlock>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════ Right: video background (or fallback) ══════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- Sourced conditionally in code-behind only when wwwroot/videos/login-bg.mp4 exists. -->
            <MediaPlayerElement x:Name="BgVideoPlayer" Stretch="UniformToFill"
                                 AreTransportControlsEnabled="False" Visibility="Collapsed" />

            <!-- Static fallback ── shown whenever the video file isn't present on disk. Layered
                 diagonal gradients (two sibling Borders, same layering technique as
                 DashboardPage.xaml's hero-card base gradient + photo) per CLAUDE.md's depth-system
                 rules, aviation-dusk toned so the page still reads as finished and intentional with
                 no video shipped yet. -->
            <Grid x:Name="FallbackBgGrid" Visibility="Visible">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1B33" Offset="0.0" />
                            <GradientStop Color="#0A0D17" Offset="0.55" />
                            <GradientStop Color="#162A46" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#284D9BEC" Offset="0.0" />
                            <GradientStop Color="#000C111D" Offset="0.6" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Seam scrim ── narrow gradient at the left edge of this column, blending into the
                 left panel. Deliberately narrow (per the design spec): the rest of the video/fallback
                 stays clearly visible, not washed out under a full-bleed scrim. -->
            <Border Width="150" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0C111D" Offset="0.0" />
                        <GradientStop Color="#000C111D" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

        </Grid>

    </Grid>
</Page>
