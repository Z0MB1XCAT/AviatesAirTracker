<Page
    x:Class="AviatesAirTracker.Pages.PilotHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\PilotHub.razor's Career section
      (dark theme values from wwwroot\css\app.css), hardcoded inline per the same Phase 2/3 rule
      DashboardPage.xaml documents: no Style element and no new Theme\Tokens.xaml entry may
      appear anywhere in this project's XAML, or XamlCompiler.exe silently crashes on this SDK.
      Every color/spacing value below is a direct property value, not a resource.

      A pilot's booking (MaxBookings = 1, BookingService.cs) now shows inline as its own
      "Current Booking" card just below the header instead of linking out to a separate list
      page; with only ever one booking to show, a whole page for it stopped making sense.

      NOTE: XAML comments are plain XML comments, so a literal double hyphen anywhere inside
      one is invalid XML and crashes XamlCompiler.exe the same way the Style/resource issue
      does; use a single hyphen, a semicolon, or a real em dash character instead.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="Pilot Hub" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Your career progress, landing analysis, and flight bookings."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Current booking card ──
                 One of three mutually-exclusive states, toggled in code-behind from
                 PilotHubViewModel.CurrentBooking (null/expired/CurrentBooking.IsActivated): no
                 booking at all (collapsed entirely; nothing shown, matching the empty-state
                 convention every other card on this page uses), an unactivated confirmed booking
                 (route/callsign/aircraft/scheduled time + Activate/Cancel), an activated one
                 (same details, but Activate/Cancel are replaced by a plain "Activated" indicator;
                 activating is a one-way action, see OnActivateBookingTapped's own comment), or an
                 expired one (BookingService.ExpireIfStaleAsync already cancelled it server-side by
                 the time this renders; this is just the after-the-fact notice). -->
            <Border x:Name="BookingCardBorder" Background="#0C111D" BorderBrush="#14FFFFFF"
                    BorderThickness="1" CornerRadius="20" Padding="20" Visibility="Collapsed">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CURRENT BOOKING" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <Border x:Name="BookingExpiredChipBorder" Background="#1FEF4444"
                                    CornerRadius="6" Padding="8,3" Visibility="Collapsed">
                                <TextBlock Text="EXPIRED" FontSize="9.5" FontWeight="Bold"
                                           CharacterSpacing="60" Foreground="#EF4444" />
                            </Border>
                            <Border x:Name="BookingActivatedChipBorder" Background="#1F3EC7AC"
                                    CornerRadius="6" Padding="8,3" Visibility="Collapsed">
                                <TextBlock Text="ACTIVATED" FontSize="9.5" FontWeight="Bold"
                                           CharacterSpacing="60" Foreground="#3EC7AC" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="BookingRouteText" FontFamily="{StaticResource DisplayFontBold}"
                                   FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                        <TextBlock x:Name="BookingDetailText" FontSize="12.5" Foreground="#94A3B8" />
                        <!-- Shown when OnActivateBookingTapped's server call fails; SimBrief still
                             opens either way (see PilotHubViewModel.ActivateCurrentBookingAsync's
                             own comment), but the booking stays unactivated and this explains why,
                             instead of the pilot just seeing nothing happen and assuming it worked. -->
                        <TextBlock x:Name="BookingActivateErrorText" FontSize="12" Foreground="#EF4444"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" x:Name="BookingActionsPanel" Spacing="8" VerticalAlignment="Center">
                        <!-- Activate: opens SimBrief dispatch pre-filled from this booking, then
                             marks it activated server-side. Primary/accent styling since this is
                             the action the pilot is meant to take before flying. -->
                        <Border x:Name="BookingActivateBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnActivateBookingTapped" AutomationProperties.Name="Activate booking"
                                                               Tapped="OnActivateBookingTapped"
                                Background="#4D9BEC" CornerRadius="10" Padding="14,8">
                            <TextBlock Text="Activate" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </Border>
                        <Border x:Name="BookingCancelBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnCancelBookingTapped" AutomationProperties.Name="Cancel booking"
                                                             Tapped="OnCancelBookingTapped"
                                Background="#1AEF4444" BorderBrush="#4DEF4444" BorderThickness="1"
                                CornerRadius="10" Padding="14,8">
                            <TextBlock Text="Cancel" FontSize="12.5" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Center" />
                        </Border>
                        <!-- Shown instead of both buttons once activated; re-opens the same
                             SimBrief dispatch URL rather than doing nothing, since the pilot may
                             have closed the browser tab and wants it back. It does NOT re-trigger
                             the one-way activation call itself. -->
                        <Border x:Name="BookingActivatedRow" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnReopenDispatchTapped" AutomationProperties.Name="Reopen SimBrief"
                                                             Tapped="OnReopenDispatchTapped" Visibility="Collapsed"
                                Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="14,8">
                            <TextBlock Text="Reopen SimBrief" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Stat strip ── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1F4D9BEC">
                            <!-- PilotHub.razor's "blue" stat-icon: the same Lucide send-glyph path
                                 DashboardPage.xaml already uses for its Flights stat. -->
                            <Viewbox Width="20" Height="20">
                                <Path Data="M22 16.5L13 3l-2 4-5-1L2 9l5 2-1 3 4 1 1 5 5-3z"
                                      Stroke="#4D9BEC" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalFlights, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Total Flights" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1A06B6D4">
                            <!-- PilotHub.razor's "cyan" stat-icon: a clock (circle + hands), same
                                 coordinates DashboardPage.xaml already uses for its Hours stat. -->
                            <Viewbox Width="20" Height="20">
                                <Grid Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Stroke="#06B6D4" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Polyline Points="12,6 12,12 16,14" Stroke="#06B6D4" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding BlockHours, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Block Hours" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1F3EC7AC">
                            <!-- PilotHub.razor's "green" stat-icon: the same activity-zigzag
                                 polyline DashboardPage.xaml already uses for its Landing stat. -->
                            <Viewbox Width="20" Height="20">
                                <Polyline Points="22,12 18,12 15,21 9,3 6,12 2,12" Stroke="#3EC7AC" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding AvgLandingScore, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Avg Landing" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1FB8934A">
                            <!-- PilotHub.razor's "violet" stat-icon: new to this page, a
                                 compass/star shape (not reused from Dashboard). -->
                            <Viewbox Width="20" Height="20">
                                <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                                      Stroke="#B8934A" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalDistance, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="26"
                                       Foreground="#F1F5F9" Margin="0,0,0,3" />
                            <TextBlock Text="Total nm" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Career detail row: Rank Progression / Last Landing Analysis ──
                 Mirrors PilotHub.razor's grid-template-columns:1fr 1fr wrapper around both
                 cards. This task (Task 2) only builds the Rank Progression card in Column 0;
                 Column 1 (Last Landing Analysis) is added by Task 3 into this same Grid. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rank Progression card. app.css's .rank-card diagonal gradient background;
                     the ::after radial-glow pseudo-element is skipped as decorative, same call
                     Dashboard made for its own hero/rank-ring card glows. The progress
                     indicator here is a plain width-animated BAR (two nested Borders), not the
                     SVG-arc ring Dashboard's own rank indicator uses; PilotHub.razor really
                     does use a different widget for this. RankProgressFill's Width is computed
                     once in code-behind after RefreshAsync() completes; RankProgressTrackWidth
                     there must be kept equal to this Border's own fixed Width below. -->
                <Border Grid.Column="0" CornerRadius="20" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0" />
                            <GradientStop Color="#1E3A8A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="🪖 RANK STATUS" FontSize="11" FontWeight="Bold" Foreground="#D9FFFFFF" />
                        </Border>

                        <TextBlock Text="{Binding PilotRank, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="22" FontWeight="ExtraBold"
                                   Foreground="#FFFFFF" Margin="0,0,0,4" />

                        <!-- "{pct}% progress toward {next}"; set once in code-behind after
                             RefreshAsync() since it combines two ViewModel values into one
                             formatted sentence (same reasoning as RankProgressFill.Width below). -->
                        <TextBlock x:Name="RankSubText" FontSize="13" Foreground="#8CFFFFFF"
                                   TextWrapping="Wrap" Margin="0,0,0,20" />

                        <Border x:Name="RankProgressTrack" Width="600" Height="8" CornerRadius="999"
                                Background="#1FFFFFFF" Margin="0,0,0,8">
                            <Border x:Name="RankProgressFill" Width="0" CornerRadius="999" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4D9BEC" Offset="0.0" />
                                        <GradientStop Color="#A78BFA" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <Grid Width="600" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PilotRank, Mode=OneWay}"
                                       FontSize="11" Foreground="#73FFFFFF" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding NextRank, Mode=OneWay}"
                                       FontSize="11" Foreground="#73FFFFFF" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Mini-stat row: duplicates TotalFlights/BlockHours/AvgLandingScore
                             from the stat strip above, same as the current Blazor page. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalFlights, Mode=OneWay}"
                                           FontFamily="{StaticResource DisplayFontBold}" FontSize="18"
                                           FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="FLIGHTS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#73FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="1" BorderBrush="#1AFFFFFF" BorderThickness="1,0,1,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BlockHours, Mode=OneWay}"
                                               FontFamily="{StaticResource DisplayFontBold}" FontSize="18"
                                               FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="HOURS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#73FFFFFF" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AvgLandingScore, Mode=OneWay}"
                                           FontFamily="{StaticResource DisplayFontBold}" FontSize="18"
                                           FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="AVG SCORE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#73FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last Landing Analysis card. app.css's .panel-card: surface bg, hairline
                     border, r-xl radius. The score ring reuses DashboardPage.xaml.cs's
                     BuildRingArc (made internal for this) but with THIS panel's own numbers;
                     app.css's ".score-ring" svg is 160x160, r=65, stroke-width=14, which is a
                     different circle from Dashboard's own rank ring (r=45, stroke-width=8). The
                     ring Stroke color is grade-dependent (computed per-landing in code-behind),
                     unlike Dashboard's single static accent-blue ring. Empty-state vs content
                     visibility is toggled in code-behind after RefreshAsync(), same pattern as
                     DashboardPage.xaml.cs's EmptyFlightsText/FlightsList pair. -->
                <Border Grid.Column="1" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="20" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Last Landing Analysis"
                                       FontFamily="{StaticResource DisplayFontBold}" FontSize="15" FontWeight="Bold"
                                       Foreground="#F1F5F9" VerticalAlignment="Center" />
                            <!-- Navigates to the new LogbookPage (full landing history); same
                                 this.Frame.Navigate pattern DashboardPage.xaml.cs's own
                                 "View Flights" CTA uses for FlightsPage. -->
                            <TextBlock Grid.Column="1" Text="View all" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#4D9BEC" VerticalAlignment="Center"
                                       IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnViewLogbookTapped" AutomationProperties.Name="View all"
                                       Tapped="OnViewLogbookTapped" />
                        </Grid>

                        <!-- Empty state: shown when !VM.HasLandings. -->
                        <TextBlock x:Name="LastLandingEmptyText"
                                   Text="Complete your first flight to see landing stats here."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Padding="0,48" />

                        <StackPanel x:Name="LastLandingContent" Visibility="Collapsed">

                            <!-- Score ring: static muted-track Ellipse + a Path (LandingRingArc)
                                 whose Data/Stroke are computed once in code-behind. Grid is
                                 160x160 (matching app.css's svg viewBox exactly) so BuildRingArc's
                                 centerX/centerY of 80,80 line up with its own cx/cy=80 without
                                 any offset math. -->
                            <Grid Width="160" Height="160" Margin="0,0,0,20" HorizontalAlignment="Center">
                                <Ellipse Width="130" Height="130" StrokeThickness="14" Stroke="#121A2A" />
                                <Path x:Name="LandingRingArc" StrokeThickness="14"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LandingScoreText"
                                               FontFamily="{StaticResource DisplayFontBold}" FontSize="36"
                                               FontWeight="ExtraBold" Foreground="#F1F5F9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="LandingGradeText" FontSize="13" FontWeight="Bold"
                                               Foreground="#64748B" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 2x2 readout grid: V/S, Pitch, Crosswind, Runway. -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#121A2A" CornerRadius="12" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="V/S" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="LandingVsText"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="15" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="#121A2A" CornerRadius="12" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Pitch" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="LandingPitchText"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="15" FontWeight="Bold"
                                                   Foreground="#4D9BEC" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="#121A2A" CornerRadius="12" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Crosswind" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="LandingCrosswindText"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="15" FontWeight="Bold"
                                                   Foreground="#F1F5F9" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="#121A2A" CornerRadius="12" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Runway" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="LandingRunwayText"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="15" FontWeight="Bold"
                                                   Foreground="#F1F5F9" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── Landing History table ──
                 PilotHub.razor's .data-table-wrap/.data-table, reproduced as a Grid-per-row
                 ItemsControl since WinUI has no <table> equivalent. Header Grid and each row's
                 Grid use identical star-weighted ColumnDefinitions so the two line up; both are
                 direct children of the same MaxWidth=1440 StackPanel so their available widths
                 match. Empty-state vs content visibility toggled in code-behind after
                 RefreshAsync(), same pattern as EmptyFlightsText/FlightsList and
                 LastLandingEmptyText/LastLandingContent above. -->
            <StackPanel Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Landing History"
                               FontFamily="{StaticResource DisplayFontBold}" FontSize="17" FontWeight="Bold"
                               Foreground="#F1F5F9" VerticalAlignment="Center" />
                    <!-- Navigates to the new LogbookPage; same handler as the card above's
                         "View all" link. -->
                    <TextBlock Grid.Column="1" Text="View logbook" FontSize="13" FontWeight="SemiBold"
                               Foreground="#4D9BEC" VerticalAlignment="Center"
                               IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnViewLogbookTapped" AutomationProperties.Name="View logbook"
                               Tapped="OnViewLogbookTapped" />
                </Grid>

                <!-- Empty state: shown when !VM.HasLandings. Exact copy from PilotHub.razor. -->
                <TextBlock x:Name="LandingHistoryEmptyText"
                           Text="No landings recorded yet. Complete a flight to see your history here."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Padding="0,48" />

                <Border x:Name="LandingHistoryContent" Background="#0C111D" BorderBrush="#14FFFFFF"
                        BorderThickness="1" CornerRadius="20" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Padding="16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="7" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="DATE" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="RUNWAY" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="2" Text="V/S" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="3" Text="PITCH" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="4" Text="CROSSWIND" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="5" Text="SCORE" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                            <TextBlock Grid.Column="6" Text="GRADE" FontSize="10.5" FontWeight="Bold"
                                       CharacterSpacing="80" Foreground="#64748B" />
                        </Grid>

                        <ItemsControl x:Name="LandingHistoryList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,13" ColumnSpacing="12" Background="Transparent"
                                          Tag="{Binding}" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnLandingRowTapped" AutomationProperties.Name="Open landing analysis"
                                                          Tapped="OnLandingRowTapped"
                                          ToolTipService.ToolTip="Open the landing analysis">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="7" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1"
                                                VerticalAlignment="Bottom" />

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding AirportLine}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#F1F5F9" />
                                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding RunwayText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="{Binding VsText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="12"
                                                   Foreground="{Binding VsColor}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="{Binding PitchText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="12"
                                                   Foreground="#CBD5E1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4" Text="{Binding CrosswindText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="12"
                                                   Foreground="#CBD5E1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="5" Text="{Binding ScoreText}"
                                                   FontFamily="{StaticResource DisplayFontBold}" FontSize="15"
                                                   FontWeight="Bold" Foreground="{Binding ScoreColor}"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Background="{Binding GradeChipBackground}"
                                                    CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding GradeLetter}" FontSize="10" FontWeight="Bold"
                                                           CharacterSpacing="80" Foreground="{Binding GradeChipColor}" />
                                            </Border>
                                            <!-- See LandingComplianceChecker; shown when this landing tripped a
                                                 compliance check (hard landing, unstabilized approach, etc). -->
                                            <Border Background="#1FEF4444" CornerRadius="6" Padding="8,3"
                                                    Visibility="{Binding ShowReviewBadge}">
                                                <TextBlock Text="REVIEW" FontSize="9.5" FontWeight="Bold"
                                                           CharacterSpacing="60" Foreground="#EF4444" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
