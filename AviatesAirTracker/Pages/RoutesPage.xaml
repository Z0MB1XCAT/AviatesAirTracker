<Page
    x:Class="AviatesAirTracker.Pages.RoutesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Routes.razor, following the same
      Phase 2/3 rules every prior native page in this migration has followed: no Style element
      and no new Theme\Tokens.xaml entry may appear anywhere in this project's XAML (silently
      crashes XamlCompiler.exe on this SDK), and no literal double hyphen inside any XAML
      comment (invalid XML, same silent crash), use a single hyphen or the box-drawing "──"
      character instead. Every color/spacing value below is a direct property value; existing
      Theme\Tokens.xaml/Typography.xaml StaticResource lookups (DisplayFontBold,
      SidebarActiveBrush, etc.) are fine to reuse since those entries already exist.

      This task (Task 2) builds the page skeleton, position banner, tab bar, search, and the
      route card grid. The booking dialog (Task 3) is wired up separately, the "Book" button
      below is a no-op Tapped handler for now.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="Route Network" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Explore all available routes across AviatesAir mainline, cargo, and regional operations."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Position instrument: locked state ──
                 Routes.razor's .pos-instrument. A plain static Ellipse is used for the status
                 dot rather than the original's pulsing keyframe animation; a deliberate
                 simplification, not an oversight (see Task 2's report). -->
            <Border x:Name="PositionLockedBorder" Visibility="Collapsed" Background="#0B1628"
                    BorderBrush="#404D9BEC" BorderThickness="1" CornerRadius="16" Padding="20,14">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="0">
                        <TextBlock Text="CURRENT POSITION" FontFamily="Consolas" FontSize="10"
                                   FontWeight="SemiBold" CharacterSpacing="60" Foreground="#B34D9BEC" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="PositionIataText" FontFamily="Consolas" FontSize="22"
                                       FontWeight="Bold" Foreground="#FFFFFF" CharacterSpacing="30" />
                            <TextBlock Text="Showing departures from this airport only" FontSize="12"
                                       Foreground="#66FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Width="1" Height="32" Background="#14FFFFFF" />

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="PositionRouteCountText" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#59FFFFFF" />
                        <TextBlock Text="Next dep. must be from here" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#59FFFFFF" />
                    </StackPanel>

                    <Border Grid.Column="4" Tag="reposition" Tapped="OnRepositionTapped"
                            Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M4,10 A6,6 0 1 1 6.2,14.6 M4,10 L4,7 M4,10 L7,10"
                                      Stroke="#80FFFFFF" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="Reposition" FontSize="12" Foreground="#80FFFFFF" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Position instrument: free/no-position state ──
                 Routes.razor's .pos-free-banner. Exact copy text. -->
            <Border x:Name="PositionFreeBorder" Visibility="Collapsed" BorderBrush="#334155"
                    BorderThickness="1.5" CornerRadius="16" Padding="18,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="#8064748B" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Line X1="12" Y1="16" X2="12" Y2="12" Stroke="#8064748B" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Width="2" Height="2" Fill="#8064748B" HorizontalAlignment="Center"
                                     VerticalAlignment="Top" Margin="0,7,0,0" />
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="No base airport set — showing all routes. Your position will lock automatically after your first completed flight."
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Tab bar + Find Route ──
                 Same Border-active-state technique FlightsPage.xaml.cs already established.
                 4th tab's Tag is "cityhopper"; the label reads "Regional" but the internal
                 filter value must match RoutesService.GetRoutesAsync's fleet parameter, which
                 is "cityhopper" server-side (confirmed against Routes.razor's own SwitchTab
                 call and GetFleetColor's switch). -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border x:Name="TabAllBorder" Tag="all" Tapped="OnTabTapped" CornerRadius="10" Padding="16,9">
                        <TextBlock x:Name="TabAllText" Text="All Routes" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="TabMainlineBorder" Tag="mainline" Tapped="OnTabTapped" CornerRadius="10" Padding="16,9">
                        <TextBlock x:Name="TabMainlineText" Text="Mainline" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="TabCargoBorder" Tag="cargo" Tapped="OnTabTapped" CornerRadius="10" Padding="16,9">
                        <TextBlock x:Name="TabCargoText" Text="Cargo" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="TabRegionalBorder" Tag="cityhopper" Tapped="OnTabTapped" CornerRadius="10" Padding="16,9">
                        <TextBlock x:Name="TabRegionalText" Text="Regional" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Tag="search" Tapped="OnFindRouteTapped" Background="#4D9BEC"
                        CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14">
                            <Grid Width="24" Height="24">
                                <Ellipse Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Line X1="21" Y1="21" X2="16.65" Y2="16.65" Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Find Route" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Search box ──
                 Debounced via a 400ms DispatcherTimer reset on every TextChanged, the native
                 equivalent of Routes.razor's Task.Delay+CancellationTokenSource restart pattern. -->
            <TextBox x:Name="SearchBox" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left"
                     PlaceholderText="Search by IATA code, airport name, or callsign…"
                     TextChanged="OnSearchTextChanged" />

            <!-- ── Loading state ── -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Padding="0,60" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock Text="Loading routes…" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ── Empty state: locked position, no routes from this airport ──
                 Exact copy from Routes.razor's .pos-no-routes panel. -->
            <StackPanel x:Name="EmptyLockedPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Padding="0,64" Spacing="8">
                <TextBlock x:Name="EmptyLockedIataText" FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                           Foreground="#334155" CharacterSpacing="40" HorizontalAlignment="Center" />
                <TextBlock Text="No scheduled routes depart from this airport." FontSize="13.5"
                           Foreground="#94A3B8" HorizontalAlignment="Center" />
                <TextBlock Text="Click Reposition above to fly from a different base." FontSize="12"
                           Foreground="#334155" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ── Empty state: generic (no routes found / no search matches) ──
                 Exact copy from Routes.razor's generic empty-state panel. -->
            <StackPanel x:Name="EmptyGenericPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Padding="0,60" Spacing="16">
                <Viewbox Width="48" Height="48" Opacity="0.25">
                    <Path Data="M22 16.5L13 3l-2 4-5-1L2 9l5 2-1 3 4 1 1 5 5-3z" Stroke="#94A3B8"
                          StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Viewbox>
                <TextBlock x:Name="EmptyGenericText" FontSize="13.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ── Result count strip ── -->
            <TextBlock x:Name="ResultCountText" Visibility="Collapsed" FontSize="12" Foreground="#94A3B8" />

            <!-- ── Route card grid ──
                 ItemsWrapGrid wraps cards into rows; ItemWidth is recomputed in code-behind
                 (UpdateRouteGridColumns) from the panel's own ActualWidth so columns stretch to
                 fill the available width instead of leaving a dead gap when it doesn't divide
                 evenly by a fixed card width. Each card is HorizontalAlignment="Stretch" so it
                 fills its ItemWidth cell (minus the right/bottom gutter margin). -->
            <ItemsControl x:Name="RouteCardsList" SizeChanged="RouteCardsList_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="Stretch" Margin="0,0,16,16" Background="#0C111D" BorderBrush="#14FFFFFF"
                                BorderThickness="1" CornerRadius="20" Padding="20">
                            <StackPanel Spacing="10">

                                <!-- Head: fleet icon + Active status chip -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                            Background="{Binding IconBackground}">
                                        <Viewbox Width="18" Height="18">
                                            <Path Data="M22 16.5L13 3l-2 4-5-1L2 9l5 2-1 3 4 1 1 5 5-3z"
                                                  Stroke="{Binding IconColor}" StrokeThickness="2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Viewbox>
                                    </Border>
                                    <Border Grid.Column="1" Background="#1A3EC7AC" CornerRadius="999"
                                            Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" Fill="#3EC7AC" VerticalAlignment="Center" />
                                            <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#3EC7AC" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Title: flags + IATA route
                                     Reproduces app.css's .flag-route/.flag-route-dep/.flag-route-arr: a single
                                     rounded chip with the two flags fading into a shared dark seam, not two
                                     separate icons. WinUI has no CSS mask-image equivalent, so the fade is faked
                                     with an overlay Rectangle per flag whose LinearGradientBrush goes from
                                     Transparent to the chip's own background color, each Image given its own
                                     non-overlapping half (0-26 / 26-52) so neither flag's fully-opaque pixels can
                                     hard-clip the other's fade partway through (the earlier version let the two
                                     Images' bounds overlap, and whichever was drawn on top being fully opaque
                                     clipped the other flag's gradient dead at its own edge instead of letting it
                                     fade smoothly, the "hard seam" reported after the first pass). Both flags
                                     now taper into the same dark midpoint instead. -->
                                <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{Binding RouteTooltip}">
                                    <Border Width="52" Height="34" CornerRadius="6" Background="#0C111D"
                                            BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding OriginFlagSource}" Width="26" Height="34"
                                                   HorizontalAlignment="Left" Stretch="UniformToFill" />
                                            <Rectangle Width="26" Height="34" HorizontalAlignment="Left">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="Transparent" Offset="0.25" />
                                                        <GradientStop Color="#0C111D" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Image Source="{Binding DestFlagSource}" Width="26" Height="34"
                                                   HorizontalAlignment="Right" Stretch="UniformToFill" />
                                            <Rectangle Width="26" Height="34" HorizontalAlignment="Right">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#0C111D" Offset="0.0" />
                                                        <GradientStop Color="Transparent" Offset="0.75" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding RouteLabel}" FontFamily="{StaticResource DisplayFontBold}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                </StackPanel>

                                <TextBlock Text="{Binding SubText}" FontSize="12.5" Foreground="#94A3B8"
                                           TextWrapping="Wrap" />

                                <!-- Chips: aircraft type, frequency, flight number -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="#1F4D9BEC" CornerRadius="6" Padding="8,3"
                                            Visibility="{Binding ShowAircraftChip}">
                                        <TextBlock Text="{Binding AircraftType}" FontSize="11" FontWeight="SemiBold" Foreground="#4D9BEC" />
                                    </Border>
                                    <Border Background="#1F3EC7AC" CornerRadius="6" Padding="8,3"
                                            Visibility="{Binding ShowFrequencyChip}">
                                        <TextBlock Text="{Binding Frequency}" FontSize="11" FontWeight="SemiBold" Foreground="#3EC7AC" />
                                    </Border>
                                    <Border Background="#0DFFFFFF" CornerRadius="6" Padding="8,3"
                                            Visibility="{Binding ShowFlightNumberChip}">
                                        <TextBlock Text="{Binding FlightNumber}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    </Border>
                                </StackPanel>

                                <!-- Footer: distance / block time + Book -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding DistanceText}" FontFamily="{StaticResource DisplayFontBold}"
                                                   FontSize="16" Foreground="#F1F5F9" />
                                        <TextBlock Text="Naut. Miles" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="1" Margin="24,0,0,0">
                                        <TextBlock Text="{Binding BlockTimeText}" FontFamily="{StaticResource DisplayFontBold}"
                                                   FontSize="16" Foreground="#F1F5F9" />
                                        <TextBlock Text="Block Time" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="#4D9BEC" CornerRadius="8" Padding="14,8"
                                            Tag="{Binding}" Tapped="OnBookTapped" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Width="13" Height="13">
                                                <Path Data="M3,4 L21,4 L21,22 L3,22 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10"
                                                      Stroke="#FFFFFF" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Viewbox>
                                            <TextBlock Text="Book" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
