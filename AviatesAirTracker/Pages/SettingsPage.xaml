<Page
    x:Class="AviatesAirTracker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Settings.razor (1058 lines, by far
      the largest converted page). Same Phase 2/3 rules every prior native page in this migration
      has followed: no Style element and no new Theme\Tokens.xaml entry may appear anywhere in
      this project's XAML (silently crashes XamlCompiler.exe on this SDK), and no literal double
      hyphen inside any XAML comment (invalid XML, same silent crash) - use a single hyphen or the
      box-drawing "──" character instead. Every color/spacing value below is a direct property
      value, taken from wwwroot/css/app.css's html[data-theme="dark"] token block (the same hex
      values every prior native page hardcodes: surface #0C111D, border rgba(255,255,255,0.08) =
      #14FFFFFF, border-light rgba(255,255,255,0.05) = #0DFFFFFF, surface-2 #121A2A, text-primary
      #F1F5F9, text-secondary #CBD5E1, text-muted #64748B, accent #4D9BEC, accent-light
      rgba(77,155,236,0.12) = #1F4D9BEC, champagne/violet #B8934A).

      This page has no ViewModel - it reads/writes SettingsService.Settings directly (a plain
      mutable object), matching Settings.razor's own direct-binding approach, closer to how
      Fleet/Dashboard/Pilot Hub are built than Routes/Events/Messages (which have ViewModels).

      Task 1 (this task) builds the page skeleton, the two-column layout, the status banner, and
      the Pilot Profile / Appearance / SimBrief Integration panels (left column). The right column
      is an intentionally empty stub - see the comment above RightColumnPanel below for exactly
      which later task builds what there.

      Border-not-Button: no Style element means Button's CornerRadius doesn't reliably render on
      this SDK, so every clickable element here (theme cards) is a Border + Tapped handler.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Configure your pilot profile, ACARS connection, and application preferences."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Status banner ──
                 Dismissible, success/error visual variants - colors/border swapped in code-behind
                 (UpdateStatusBanner), same visual pattern EventsPage/MessagesPage already
                 established for their own status banners. -->
            <Border x:Name="StatusBanner" Visibility="Collapsed" CornerRadius="12" Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Tag="close" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnStatusCloseTapped" AutomationProperties.Name="Close"
                                                        Tapped="OnStatusCloseTapped" VerticalAlignment="Center" Padding="6,0">
                        <TextBlock x:Name="StatusCloseText" Text="&#x2715;" FontSize="14" />
                    </Border>
                </Grid>
            </Border>

            <!-- ── Two-column layout ── -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── Left column ── -->
                <StackPanel Grid.Column="0" Spacing="20">

                    <!-- ── Pilot Profile ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Pilot Profile" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Avatar row: avatar + verified badge, display name + VERIFIED chip,
                                 subtitle, conditional email row. -->
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar circle (initials over an accent->champagne diagonal
                                         gradient) + verified-checkmark badge, absolutely positioned
                                         at the avatar's bottom-right corner via a negative-margin
                                         Border inside this Grid (WinUI has no CSS position:absolute
                                         equivalent, and Grid does not clip overflowing children). -->
                                    <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Top">
                                        <Border Width="60" Height="60" CornerRadius="30">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4D9BEC" Offset="0.0" />
                                                    <GradientStop Color="#B8934A" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="AvatarInitialsText" Text="?"
                                                       FontFamily="{StaticResource DisplayFontBold}"
                                                       FontSize="22" FontWeight="ExtraBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="VerifiedBadgeBorder" Visibility="Collapsed"
                                                Width="20" Height="20" CornerRadius="10" Background="#4D9BEC"
                                                BorderBrush="#080B14" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-3,-3">
                                            <Viewbox Width="10" Height="10">
                                                <Polyline Points="20,6 9,17 4,12" Stroke="White" StrokeThickness="3"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Viewbox>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="DisplayNameText" Text="Pilot" FontSize="14"
                                                       FontWeight="Bold" Foreground="#F1F5F9" />
                                            <Border x:Name="VerifiedChipBorder" Visibility="Collapsed"
                                                    Background="#1F4D9BEC" CornerRadius="20" Padding="8,2">
                                                <TextBlock Text="VERIFIED" FontSize="10" FontWeight="Bold"
                                                           Foreground="#4D9BEC" CharacterSpacing="40" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="PilotIdSubtitleText" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                        <StackPanel x:Name="VerifiedEmailRow" Visibility="Collapsed"
                                                    Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                            <Viewbox Width="11" Height="11">
                                                <Grid Width="24" Height="24">
                                                    <Rectangle Width="18" Height="14" RadiusX="2" RadiusY="2"
                                                               Stroke="#64748B" StrokeThickness="2"
                                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                    <Polyline Points="3,7 12,13 21,7" Stroke="#64748B" StrokeThickness="2"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock x:Name="VerifiedEmailText" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Pilot Name: read-only, synced from the ACARS account, not locally
                                 editable. Pilot ID intentionally has no field here at all; it is
                                 still used internally (SettingsService.Settings.PilotId, required
                                 for the messaging system to route/display messages correctly),
                                 just never shown or editable on this page. -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Pilot Name" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                    <TextBlock x:Name="PilotNameText" FontSize="14" Foreground="#F1F5F9" Padding="14,10" />
                                </Border>
                            </StackPanel>

                            <!-- Log Out: same danger-tinted Border+Tapped treatment as AcarsPage's
                                 End Flight action (Background #1AEF4444 / BorderBrush #EF4444 /
                                 Foreground #EF4444), gated behind ConfirmDialog per the design spec. -->
                            <Border x:Name="LogOutButtonBorder" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnLogOutTapped" AutomationProperties.Name="Log Out"
                                                                Tapped="OnLogOutTapped"
                                    Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1.5"
                                    CornerRadius="12" Padding="14,10" HorizontalAlignment="Left">
                                <TextBlock Text="Log Out" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── SimBrief Integration ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="SimBrief Integration" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="SimBrief Username or ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <!-- Reads live state, not a load-time snapshot: Task 2's ACARS sync
                                         flow can populate SimBriefUsername and flip _isVerified well
                                         after this page has already loaded. -->
                                    <TextBlock x:Name="SimBriefSyncedHintText" Text="· synced from account"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Visibility="Collapsed" />
                                </StackPanel>
                                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                    <TextBox x:Name="SimBriefUsernameTextBox" PlaceholderText="Username or numeric pilot ID"
                                             Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                             Padding="14,10" TextChanged="OnSimBriefUsernameTextChanged" />
                                </Border>
                            </StackPanel>
                            <Border Background="#121A2A" CornerRadius="12" Padding="13,10">
                                <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="Accepts your SimBrief username (e.g. " />
                                    <Run Text="jsmith" FontWeight="Bold" />
                                    <Run Text=") or numeric pilot ID. You can override this; your account value is only applied on first sync." />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ── Right column ──
                     Task 2 (this task) builds ACARS Configuration and Friend Code. Task 3 adds
                     Hoppies ACARS and App Preferences (stub Borders below mark exactly where).
                     Task 4 adds Dispatch Radio. Task 5 adds About &amp; Updates and EFB Companion.
                     Panel order matches Settings.razor's own top-to-bottom order in this column. -->
                <StackPanel Grid.Column="1" Spacing="20">

                    <!-- ── ACARS Configuration ──
                         Temporarily hidden from the UI (Visibility="Collapsed") while the setting
                         itself, and everything that reads/writes it in code-behind, stays intact -
                         only the panel's visibility changed here. -->
                    <Border Visibility="Collapsed" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="ACARS Configuration" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- ACARS Key field + Verify &amp; Sync button. PasswordBox mirrors the
                                 TextBox pattern used elsewhere in this file (Background=Transparent,
                                 BorderThickness=0, wrapped in a custom-colored Border) so its own
                                 default chrome doesn't fight the app's hardcoded dark palette. -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="ACARS Key" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                        <PasswordBox x:Name="AcarsKeyPasswordBox" PlaceholderText="Paste your ACARS key"
                                                     Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                     Padding="14,10" PasswordChanged="OnAcarsKeyPasswordChanged" />
                                    </Border>
                                    <Border Grid.Column="1" x:Name="VerifySyncButtonBorder" Tag="sync"
                                            IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnVerifySyncTapped" AutomationProperties.Name="Verify &amp; Sync"
                                            Tapped="OnVerifySyncTapped" CornerRadius="10" Padding="18,0"
                                            BorderThickness="0" VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox x:Name="VerifySyncIdleIconViewbox" Width="14" Height="14">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" Stroke="#FFFFFF"
                                                          StrokeThickness="2" StrokeLineJoin="Round" />
                                                    <Polyline Points="17,8 12,3 7,8" Stroke="#FFFFFF" StrokeThickness="2"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Line X1="12" Y1="3" X2="12" Y2="15" Stroke="#FFFFFF" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <Viewbox x:Name="VerifySyncVerifiedIconViewbox" Width="14" Height="14" Visibility="Collapsed">
                                                <Grid Width="24" Height="24">
                                                    <Polyline Points="20,6 9,17 4,12" Stroke="#F1F5F9" StrokeThickness="2.5"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <ProgressRing x:Name="VerifySyncProgressRing" IsActive="False" Visibility="Collapsed"
                                                          Width="14" Height="14" Foreground="#FFFFFF" />
                                            <TextBlock x:Name="VerifySyncButtonText" Text="Verify &amp; Sync"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Conditional info banner (verified vs. unverified copy) - both banners
                                 pre-built, visibility toggled in UpdateAcarsInfoBanner() (same
                                 established pattern as VerifiedBadgeBorder/VerifiedChipBorder). -->
                            <Border x:Name="AcarsVerifiedInfoBanner" Visibility="Collapsed"
                                    Background="#144D9BEC" BorderBrush="#334D9BEC" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Top">
                                        <Grid Width="24" Height="24">
                                            <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                                                  Stroke="#4D9BEC" StrokeThickness="2" StrokeLineJoin="Round" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="Profile synced: name and SimBrief ID have been populated from your AviatesAir account."
                                               FontSize="12.5" Foreground="#4D9BEC" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AcarsUnverifiedInfoBanner" Visibility="Visible"
                                    Background="#1F4D9BEC" CornerRadius="12" Padding="14,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Top">
                                        <Grid Width="24" Height="24">
                                            <Ellipse Width="20" Height="20" Stroke="#4D9BEC" StrokeThickness="2"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Line X1="12" Y1="8" X2="12" Y2="12" Stroke="#4D9BEC" StrokeThickness="2" StrokeStartLineCap="Round" />
                                            <Ellipse Width="1.4" Height="1.4" Fill="#4D9BEC"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15.3,0,0" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock FontSize="12.5" Foreground="#4D9BEC" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center">
                                        <Run Text="Your ACARS key is provided when you register at flyaviatesair.uk. Paste it above and click " />
                                        <Run Text="Verify &amp; Sync" FontWeight="Bold" />
                                        <Run Text=" to auto-fill your profile." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Auto position report interval -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Auto Position Report Interval" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <ComboBox x:Name="AutoPirepIntervalComboBox" HorizontalAlignment="Stretch"
                                          Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5"
                                          CornerRadius="12" Foreground="#F1F5F9" Padding="12,8"
                                          SelectionChanged="OnAutoPirepIntervalSelectionChanged">
                                    <ComboBoxItem Content="Off" Tag="0" />
                                    <ComboBoxItem Content="Every 1 minute" Tag="1" />
                                    <ComboBoxItem Content="Every 5 minutes" Tag="5" />
                                    <ComboBoxItem Content="Every 10 minutes" Tag="10" />
                                    <ComboBoxItem Content="Every 15 minutes" Tag="15" />
                                    <ComboBoxItem Content="Every 30 minutes" Tag="30" />
                                </ComboBox>
                                <TextBlock Text="Automatically sends position reports to the Aviates Air network while airborne. Requires a valid ACARS key."
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20" />
                            </StackPanel>

                            <!-- FMC shortcut hint strip - static, no interactivity (this shortcut
                                 fires from the ACARS page, not from this Settings page). -->
                            <Border Background="#121A2A" CornerRadius="12" Padding="13,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                                            CornerRadius="6" Padding="7,2">
                                        <TextBlock Text="Ctrl+Shift+F" FontFamily="Consolas" FontSize="10"
                                                   FontWeight="Bold" Foreground="#F1F5F9" CharacterSpacing="30" />
                                    </Border>
                                    <TextBlock Text="Opens the FMC overlay from anywhere on the ACARS page (a hidden shortcut)."
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Hoppies ACARS ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Hoppies ACARS" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Hoppies pilot code field -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Your Hoppies Code" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                    <PasswordBox x:Name="HoppiesPilotCodeBox" PlaceholderText="Paste your personal Hoppies logon code"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" PasswordChanged="OnHoppiesPilotCodeChanged" />
                                </Border>
                                <TextBlock Text="Stored for a future feature. Not required for company messages to reach you; those use the VA's own Hoppies connection."
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20" />
                            </StackPanel>

                            <!-- Master enable toggle - no bottom divider, matches the original's
                                 style="border-bottom:none;padding-bottom:0;" on this specific row. -->
                            <Grid ColumnSpacing="12" Padding="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Hoppies ACARS Messages" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="Send position and event updates over the Hoppies ACARS network"
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="HoppiesEnabledToggle" OnContent="" OffContent=""
                                              VerticalAlignment="Center" Toggled="OnHoppiesEnabledToggled" />
                            </Grid>

                            <!-- Category toggles - dimmed AND disabled together whenever the master
                                 toggle above is off (both at load and live, refreshed from
                                 OnHoppiesEnabledToggled — see UpdateHoppiesCategoryEnabledState in
                                 code-behind). Opacity mirrors the original's
                                 opacity:@(HoppiesEnabled ? "1" : "0.5") CSS transition. -->
                            <StackPanel x:Name="HoppiesCategoriesPanel">
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Loadsheet" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="HoppiesLoadsheetToggle" Tag="Loadsheet"
                                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                                      Toggled="OnHoppiesCategoryToggled" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Timing Reminders" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="HoppiesTimingRemindersToggle" Tag="TimingReminders"
                                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                                      Toggled="OnHoppiesCategoryToggled" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Airborne / Landing Calls" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="HoppiesAirborneLandingToggle" Tag="AirborneLandingCalls"
                                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                                      Toggled="OnHoppiesCategoryToggled" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Post-Flight Summary" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="HoppiesPostFlightSummaryToggle" Tag="PostFlightSummary"
                                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                                      Toggled="OnHoppiesCategoryToggled" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Weather Advisories" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="HoppiesWeatherAdvisoriesToggle" Tag="WeatherAdvisories"
                                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                                      Toggled="OnHoppiesCategoryToggled" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="12" Padding="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hazard Advisories" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" x:Name="HoppiesHazardAdvisoriesToggle" Tag="HazardAdvisories"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="OnHoppiesCategoryToggled" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Dispatch Radio ──
                         Per the design spec's explicit scope decision (#2): the microphone/speaker
                         dropdowns below enumerate REAL native Windows audio devices via
                         Windows.Devices.Enumeration.DeviceInformation.FindAllAsync, not the
                         original's JS-only "aviatesVoice.getAudioDevices" call (no JS runtime on
                         this native page). Selecting a device only persists the choice to
                         SettingsService - nothing native exists yet to receive an
                         "aviatesVoice.setMicrophone"/"setSpeaker"-shaped call, and inventing one
                         would be worse than clearly doing nothing beyond persisting the setting.

                         Temporarily hidden from the UI (Visibility="Collapsed") - the dispatch
                         radio function itself keeps running off whatever settings were already
                         saved; only this panel's visibility changed here. -->
                    <Border Visibility="Collapsed" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Dispatch Radio" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Dispatch Backend URL -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dispatch Backend URL" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                    <TextBox x:Name="DispatchBackendUrlTextBox"
                                             PlaceholderText="wss://aviates-dispatch-radio.dexterhsrees.workers.dev"
                                             Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                             Padding="14,10" TextChanged="OnDispatchBackendUrlTextChanged" />
                                </Border>
                            </StackPanel>
                            <Border Background="#121A2A" CornerRadius="12" Padding="13,10">
                                <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="Tune COM1 to " />
                                    <Run Text="123.575 MHz" FontWeight="Bold" />
                                    <Run Text=" in MSFS to connect to dispatch. Leave this blank if you don't have a dispatch backend URL yet." />
                                </TextBlock>
                            </Border>

                            <!-- PTT Hotkey - readonly TextBox that captures the next key pressed
                                 while it has focus (see OnPttHotkeyTextBoxKeyDown in code-behind). -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="PTT Hotkey" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                        <TextBox x:Name="PttHotkeyTextBox" IsReadOnly="True"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" GotFocus="OnPttHotkeyGotFocus" LostFocus="OnPttHotkeyLostFocus"
                                                 KeyDown="OnPttHotkeyTextBoxKeyDown" />
                                    </Border>
                                    <Border Grid.Column="1" x:Name="ClearHotkeyButtonBorder" Tag="clear" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnClearHotkeyTapped" AutomationProperties.Name="Clear push-to-talk key"
                                                                                                         Tapped="OnClearHotkeyTapped"
                                            Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10"
                                            Padding="16,0" VerticalAlignment="Stretch">
                                        <TextBlock Text="Clear" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <!-- Rejection message vs. normal hint - both pre-built, visibility
                                     toggled together in UpdatePttHotkeyDisplay() (same established
                                     pattern as AcarsVerifiedInfoBanner/AcarsUnverifiedInfoBanner). -->
                                <TextBlock x:Name="PttHotkeyRejectionText" FontSize="12" Foreground="#F87171"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                                <TextBlock x:Name="PttHotkeyHintText"
                                           Text="Click the field, then press the key you want to hold to talk. Works even while MSFS has focus."
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- PTT Joystick Button -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="PTT Joystick Button" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="JoystickComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                              Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5"
                                              CornerRadius="12" Foreground="#F1F5F9" Padding="12,8"
                                              SelectionChanged="OnJoystickComboBoxSelectionChanged" />
                                    <Border Grid.Column="1" x:Name="BindJoystickButtonBorder" Tag="bind" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnBindJoystickButtonTapped" AutomationProperties.Name="Bind Button"
                                                                                                         Tapped="OnBindJoystickButtonTapped"
                                            Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10"
                                            Padding="16,0" VerticalAlignment="Stretch">
                                        <TextBlock x:Name="BindJoystickButtonText" Text="Bind Button" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="JoystickBoundText" FontSize="12" Foreground="#64748B"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Microphone / Speaker - real native Windows.Devices.Enumeration
                                 device lists, populated asynchronously in Loaded (see
                                 LoadAudioDevicesAsync in code-behind). -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Microphone" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <ComboBox x:Name="MicrophoneComboBox" HorizontalAlignment="Stretch"
                                          Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5"
                                          CornerRadius="12" Foreground="#F1F5F9" Padding="12,8"
                                          SelectionChanged="OnMicrophoneSelectionChanged" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Speaker" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                <ComboBox x:Name="SpeakerComboBox" HorizontalAlignment="Stretch"
                                          Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5"
                                          CornerRadius="12" Foreground="#F1F5F9" Padding="12,8"
                                          SelectionChanged="OnSpeakerSelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── App Preferences ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Preferences" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Auto-connect / Desktop Alerts / Minimize to Tray: plain
                                 deferred-to-Save binds, no SettingsService.Save() call on Toggled —
                                 matches the original's plain @bind with no side effect, persisted
                                 only by the page's Save button (Task 6). -->
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-connect to MSFS" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Automatically detect and connect to MSFS on launch"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutoConnectToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnAutoConnectToggled" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Approach Alerts" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Pop up a warning when the approach becomes unstable or the landing bounces"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="ShowApproachAlertsToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnShowApproachAlertsToggled" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Minimize to Tray" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Closing the window keeps the tracker running in the system tray"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="MinimizeToTrayToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnMinimizeToTrayToggled" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Notifications" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Messages, PIREP results, event reminders and landings while the tracker is behind the sim"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="WindowsNotificationsToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnWindowsNotificationsToggled" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Open the tracker in the tray when you sign in to Windows"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StartWithWindowsToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnStartWithWindowsToggled" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Start with Microsoft Flight Simulator" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock x:Name="StartWithSimulatorStatusText" Text="Add the tracker to the sim&apos;s add-on launch list so it opens in the tray with MSFS"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StartWithSimulatorToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnStartWithSimulatorToggled" />
                                </Grid>
                            </Border>

                            <!-- Share My Live Position: the one toggle in this panel that DOES save
                                 immediately and calls AviatesBackendClient.SetLiveSharingAsync —
                                 explicitly different from the three toggles above. No bottom divider
                                 (last row), matching the original's style="border-bottom:none;". -->
                            <Grid ColumnSpacing="12" Padding="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Share My Live Position" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="Show your flight on the Aviates Air live map for other pilots and the website. Takes effect immediately."
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="ShareLivePositionToggle" OnContent="" OffContent=""
                                              VerticalAlignment="Center" Toggled="OnShareLivePositionToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Friend Code ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Friend Code" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>
                            <TextBlock FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="21"
                                       Text="Share this code with other AviatesAir pilots so they can add you as a friend in the Messages page. It is derived from your ACARS key and is safe to share publicly." />

                            <!-- Amber "set your key" prompt vs. code display - both pre-built,
                                 visibility toggled in UpdateFriendCodePanel(). -->
                            <Border x:Name="FriendCodeEmptyBanner" Visibility="Visible"
                                    Background="#1AF59E0B" CornerRadius="12" Padding="14,12">
                                <TextBlock Text="Set your ACARS key and save to generate your Friend Code."
                                           FontSize="12.5" Foreground="#F59E0B" TextWrapping="Wrap" />
                            </Border>
                            <Grid x:Name="FriendCodeDisplayGrid" Visibility="Collapsed" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="18,14">
                                    <TextBlock x:Name="FriendCodeText" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                               Foreground="#4D9BEC" CharacterSpacing="180" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" x:Name="CopyFriendCodeButtonBorder" Tag="copy"
                                        IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnCopyFriendCodeTapped" AutomationProperties.Name="Copy friend code"
                                        Tapped="OnCopyFriendCodeTapped" Background="#0C111D" BorderBrush="#14FFFFFF"
                                        BorderThickness="1" CornerRadius="10" Padding="16,0" VerticalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox x:Name="CopyIdleIconViewbox" Width="15" Height="15">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Width="13" Height="13" RadiusX="2" RadiusY="2" Stroke="#F1F5F9" StrokeThickness="2"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                                <Path Data="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" Stroke="#F1F5F9"
                                                      StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            </Grid>
                                        </Viewbox>
                                        <Viewbox x:Name="CopyDoneIconViewbox" Width="15" Height="15" Visibility="Collapsed">
                                            <Grid Width="24" Height="24">
                                                <Polyline Points="20,6 9,17 4,12" Stroke="#F1F5F9" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="CopyFriendCodeButtonText" Text="Copy" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── About & Updates ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="About &amp; Updates" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Version row: current version + Check for Updates button (idle vs
                                 checking-with-ProgressRing states, driven from code-behind's
                                 UpdateCheckForUpdatesButtonState). -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Current Version" FontSize="12" Foreground="#64748B" />
                                    <TextBlock x:Name="AppVersionText" FontFamily="Consolas" FontSize="14"
                                               FontWeight="Bold" Foreground="#F1F5F9" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="CheckForUpdatesButtonBorder" Tag="check"
                                        IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnCheckForUpdatesTapped" AutomationProperties.Name="Check for Updates"
                                        Tapped="OnCheckForUpdatesTapped" Background="#0C111D" BorderBrush="#14FFFFFF"
                                        BorderThickness="1" CornerRadius="10" Padding="16,0" VerticalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox x:Name="CheckForUpdatesIdleIconViewbox" Width="13" Height="13">
                                            <Grid Width="24" Height="24">
                                                <Path Data="M23 4v6h-6" Stroke="#F1F5F9" StrokeThickness="2" StrokeLineJoin="Round" />
                                                <Path Data="M1 20v-6h6" Stroke="#F1F5F9" StrokeThickness="2" StrokeLineJoin="Round" />
                                                <Path Data="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"
                                                      Stroke="#F1F5F9" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <ProgressRing x:Name="CheckForUpdatesProgressRing" IsActive="False" Visibility="Collapsed"
                                                      Width="13" Height="13" Foreground="#F1F5F9" />
                                        <TextBlock x:Name="CheckForUpdatesButtonText" Text="Check for Updates"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Update-available panel vs. "up to date" strip vs. nothing - matches
                                 Settings.razor's exact 3-way @if/else-if/implicit-else-nothing (both
                                 pre-built, visibility toggled together in
                                 UpdateAboutUpdatesPanel()). -->
                            <Border x:Name="UpdateAvailableBorder" Visibility="Collapsed"
                                    Background="#124D9BEC" BorderBrush="#334D9BEC" BorderThickness="1"
                                    CornerRadius="12" Padding="13,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Width="14" Height="14">
                                            <Grid Width="24" Height="24">
                                                <Polyline Points="7,16 12,21 17,16" Stroke="#4D9BEC" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Line X1="12" Y1="3" X2="12" Y2="21" Stroke="#4D9BEC" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="UpdateAvailableVersionText" FontSize="12.5"
                                                   FontWeight="Bold" Foreground="#4D9BEC" />
                                    </StackPanel>

                                    <!-- Download progress bar (while _isInstallingUpdate) vs.
                                         Download & Install button - both pre-built, visibility
                                         toggled together. Fill-width technique matches
                                         PilotHubPage.xaml's RankProgressTrack/RankProgressFill
                                         pair: a fixed-Width track Border + an inner fill Border
                                         whose Width is set in code-behind as a pixel fraction of
                                         the track's own fixed Width (UpdateProgressTrackWidth
                                         constant in code-behind must match this Border's Width). -->
                                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Downloading…" FontSize="11" Foreground="#64748B" />
                                            <TextBlock x:Name="UpdateProgressPercentText" Grid.Column="1" FontSize="11" Foreground="#64748B" />
                                        </Grid>
                                        <Border x:Name="UpdateProgressTrack" Width="380" Height="6" CornerRadius="999" Background="#14FFFFFF">
                                            <Border x:Name="UpdateProgressFill" Width="0" CornerRadius="999" Background="#4D9BEC"
                                                    HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="DownloadInstallButtonBorder" Tag="install" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnDownloadInstallTapped" AutomationProperties.Name="Download &amp; Install"
                                                                                               Tapped="OnDownloadInstallTapped"
                                            Background="#4D9BEC" CornerRadius="10" Padding="0,10" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="7"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="13" Height="13">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" Stroke="#FFFFFF"
                                                          StrokeThickness="2" StrokeLineJoin="Round" />
                                                    <Polyline Points="7,10 12,15 17,10" Stroke="#FFFFFF" StrokeThickness="2"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Line X1="12" Y1="15" X2="12" Y2="3" Stroke="#FFFFFF" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Download &amp; Install" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Hidden unless a download/install attempt actually failed;
                                         previously errors here were swallowed with no UI feedback
                                         at all, which is exactly why this bug went undiagnosed. -->
                                    <TextBlock x:Name="UpdateErrorText" Visibility="Collapsed"
                                               FontSize="12" Foreground="#F87171" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="UpToDateBanner" Visibility="Collapsed"
                                    Background="#1F3EC7AC" CornerRadius="10" Padding="10,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="13" Height="13">
                                        <Grid Width="24" Height="24">
                                            <Polyline Points="20,6 9,17 4,12" Stroke="#3EC7AC" StrokeThickness="2.5"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="You're on the latest version." FontSize="12.5" Foreground="#3EC7AC" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── EFB Companion ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="EFB Companion" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>
                            <TextBlock FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="21"
                                       Text="Host a virtual AviatesAir tablet on your network. Open the address below on an iPad, phone, or second monitor (or scan the QR) to get a live EFB with your flight dashboard, performance tools, checklists and manuals." />

                            <!-- Running state: QR code (Grid-of-Rectangle module grid, built in
                                 code-behind's BuildEfbQrGrid - NOT an SVG hack, per the design
                                 spec's explicit resolution) + status dot/label/address/pairing
                                 code + Stop button. Stopped state: info banner + Start button.
                                 Both states pre-built, visibility toggled together in
                                 UpdateEfbPanel(). -->
                            <Grid x:Name="EfbRunningGrid" Visibility="Collapsed" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="150" Height="150" Background="White"
                                        CornerRadius="12" Padding="8" VerticalAlignment="Top">
                                    <Grid x:Name="EfbQrGrid" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                                        <Ellipse Width="9" Height="9" Fill="#3EC7AC" />
                                        <TextBlock x:Name="EfbStatusText" FontSize="13" FontWeight="Bold" Foreground="#3EC7AC" />
                                    </StackPanel>
                                    <TextBlock Text="ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" CharacterSpacing="35" />
                                    <TextBlock x:Name="EfbAddressText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"
                                               TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="PAIRING CODE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" CharacterSpacing="35" />
                                    <TextBlock x:Name="EfbPairingCodeText" FontFamily="Consolas" FontSize="26"
                                               FontWeight="Bold" Foreground="#4D9BEC" CharacterSpacing="40" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="EfbStoppedBanner" Visibility="Visible"
                                    Background="#121A2A" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12">
                                <TextBlock Text="The EFB server is stopped. Start it to pair a device."
                                           FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" />
                            </Border>

                            <Border x:Name="StopEfbButtonBorder" Visibility="Collapsed" Tag="stop" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnStopEfbTapped" AutomationProperties.Name="Stop EFB Server"
                                                                                                   Tapped="OnStopEfbTapped"
                                    Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="0,10" HorizontalAlignment="Stretch">
                                <TextBlock Text="Stop EFB Server" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F1F5F9" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="StartEfbButtonBorder" Visibility="Visible" Tag="start" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnStartEfbTapped" AutomationProperties.Name="Start EFB Server"
                                                                                                   Tapped="OnStartEfbTapped"
                                    Background="#4D9BEC" CornerRadius="10" Padding="0,10" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="StartEfbButtonText" Text="Start EFB Server" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Enable EFB Companion: saves immediately AND stops the server if
                                 turned off while running (matches OnEfbEnabledChanged exactly).
                                 Start Automatically: plain deferred-to-Save bind, no immediate
                                 side effect (matches the original - do NOT save this one
                                 immediately). -->
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Enable EFB Companion" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Allow devices on your network to connect"
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="EfbEnabledToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnEfbEnabledToggled" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="12" Padding="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Start Automatically" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="Launch the EFB server when the app starts"
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="EfbAutoStartToggle" OnContent="" OffContent=""
                                              VerticalAlignment="Center" Toggled="OnEfbAutoStartToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Save / Reset ──
                         Matches Settings.razor lines 601-608: a flex-grow primary Save button beside
                         a fixed-width secondary Reset button, at the bottom of the right column below
                         EFB Companion. Border-not-Button per this page's own convention. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="SaveSettingsButtonBorder" Tag="save" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnSaveSettingsTapped" AutomationProperties.Name="Save Settings"
                                                                                             Tapped="OnSaveSettingsTapped"
                                Background="#4D9BEC" CornerRadius="10" Padding="0,12" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14">
                                    <Grid Width="24" Height="24">
                                        <Polyline Points="20,6 9,17 4,12" Stroke="#FFFFFF" StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="Save Settings" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" x:Name="ResetSettingsButtonBorder" Tag="reset" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnActivateKey" AutomationProperties.AutomationId="OnResetSettingsTapped" AutomationProperties.Name="Reset"
                                                                                               Tapped="OnResetSettingsTapped"
                                Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="20,12" VerticalAlignment="Stretch">
                            <TextBlock Text="Reset" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
