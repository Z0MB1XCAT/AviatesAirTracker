<Page
    x:Class="AviatesAirTracker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B14">

    <!--
      Native reproduction of AviatesAirTracker.LegacyWeb\Pages\Settings.razor (1058 lines, by far
      the largest converted page). Same Phase 2/3 rules every prior native page in this migration
      has followed: no Style element and no new Theme\Tokens.xaml entry may appear anywhere in
      this project's XAML (silently crashes XamlCompiler.exe on this SDK), and no literal double
      hyphen inside any XAML comment (invalid XML, same silent crash) - use a single hyphen or the
      box-drawing "──" character instead. Every color/spacing value below is a direct property
      value, taken from wwwroot/css/app.css's html[data-theme="dark"] token block (the same hex
      values every prior native page hardcodes: surface #0C111D, border rgba(255,255,255,0.08) =
      #14FFFFFF, border-light rgba(255,255,255,0.05) = #0DFFFFFF, surface-2 #121A2A, text-primary
      #F1F5F9, text-secondary #CBD5E1, text-muted #64748B, accent #4D9BEC, accent-light
      rgba(77,155,236,0.12) = #1F4D9BEC, champagne/violet #B8934A).

      This page has no ViewModel - it reads/writes SettingsService.Settings directly (a plain
      mutable object), matching Settings.razor's own direct-binding approach, closer to how
      Fleet/Dashboard/Pilot Hub are built than Routes/Events/Messages (which have ViewModels).

      Task 1 (this task) builds the page skeleton, the two-column layout, the status banner, and
      the Pilot Profile / Appearance / SimBrief Integration panels (left column). The right column
      is an intentionally empty stub - see the comment above RightColumnPanel below for exactly
      which later task builds what there.

      Border-not-Button: no Style element means Button's CornerRadius doesn't reliably render on
      this SDK, so every clickable element here (theme cards) is a Border + Tapped handler.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="1440" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ── Page header ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFontBold}"
                           FontSize="26" Foreground="#F1F5F9" />
                <TextBlock Text="Configure your pilot profile, ACARS connection, and application preferences."
                           FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <!-- ── Status banner ──
                 Dismissible, success/error visual variants - colors/border swapped in code-behind
                 (UpdateStatusBanner), same visual pattern EventsPage/MessagesPage already
                 established for their own status banners. -->
            <Border x:Name="StatusBanner" Visibility="Collapsed" CornerRadius="12" Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Tag="close" Tapped="OnStatusCloseTapped" VerticalAlignment="Center" Padding="6,0">
                        <TextBlock x:Name="StatusCloseText" Text="&#x2715;" FontSize="14" />
                    </Border>
                </Grid>
            </Border>

            <!-- ── Two-column layout ── -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── Left column ── -->
                <StackPanel Grid.Column="0" Spacing="20">

                    <!-- ── Pilot Profile ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Pilot Profile" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>

                            <!-- Avatar row: avatar + verified badge, display name + VERIFIED chip,
                                 subtitle, conditional email row. -->
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar circle (initials over an accent->champagne diagonal
                                         gradient) + verified-checkmark badge, absolutely positioned
                                         at the avatar's bottom-right corner via a negative-margin
                                         Border inside this Grid (WinUI has no CSS position:absolute
                                         equivalent, and Grid does not clip overflowing children). -->
                                    <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Top">
                                        <Border Width="60" Height="60" CornerRadius="30">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4D9BEC" Offset="0.0" />
                                                    <GradientStop Color="#B8934A" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="AvatarInitialsText" Text="?"
                                                       FontFamily="{StaticResource DisplayFontBold}"
                                                       FontSize="22" FontWeight="ExtraBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="VerifiedBadgeBorder" Visibility="Collapsed"
                                                Width="20" Height="20" CornerRadius="10" Background="#4D9BEC"
                                                BorderBrush="#080B14" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-3,-3">
                                            <Viewbox Width="10" Height="10">
                                                <Polyline Points="20,6 9,17 4,12" Stroke="White" StrokeThickness="3"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Viewbox>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="DisplayNameText" Text="Pilot" FontSize="14"
                                                       FontWeight="Bold" Foreground="#F1F5F9" />
                                            <Border x:Name="VerifiedChipBorder" Visibility="Collapsed"
                                                    Background="#1F4D9BEC" CornerRadius="20" Padding="8,2">
                                                <TextBlock Text="VERIFIED" FontSize="10" FontWeight="Bold"
                                                           Foreground="#4D9BEC" CharacterSpacing="40" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="PilotIdSubtitleText" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                        <StackPanel x:Name="VerifiedEmailRow" Visibility="Collapsed"
                                                    Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                            <Viewbox Width="11" Height="11">
                                                <Grid Width="24" Height="24">
                                                    <Rectangle Width="18" Height="14" RadiusX="2" RadiusY="2"
                                                               Stroke="#64748B" StrokeThickness="2"
                                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                    <Polyline Points="3,7 12,13 21,7" Stroke="#64748B" StrokeThickness="2"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock x:Name="VerifiedEmailText" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Pilot Name / Pilot ID fields -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Pilot Name" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                        <TextBox x:Name="PilotNameTextBox" PlaceholderText="Your full name"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" TextChanged="OnPilotNameTextChanged" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Pilot ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                        <TextBox x:Name="PilotIdTextBox" PlaceholderText="AVT-00000"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                                 Padding="14,10" TextChanged="OnPilotIdTextChanged" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Appearance ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="Appearance" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>
                            <TextBlock Text="Choose a theme or let the app follow your operating system preference."
                                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="22" />

                            <!-- Three theme-option cards. Active-state border/background/icon-stroke/
                                 label are all driven from code-behind (UpdateThemeCardVisuals) - per
                                 the design spec's explicit scope decision, tapping a card only
                                 persists Settings.Theme, it does NOT re-theme the running shell. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="ThemeSystemBorder" Tag="system"
                                        Tapped="OnThemeCardTapped" CornerRadius="12" Padding="14,10" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                            <Grid x:Name="ThemeSystemIconGrid" Width="24" Height="24">
                                                <Rectangle Width="20" Height="14" RadiusX="2" RadiusY="2"
                                                           Stroke="#64748B" StrokeThickness="2"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,3,0,0" />
                                                <Line X1="8" Y1="21" X2="16" Y2="21" Stroke="#64748B" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Line X1="12" Y1="17" X2="12" Y2="21" Stroke="#64748B" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="ThemeSystemText" Text="System" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" x:Name="ThemeLightBorder" Tag="light"
                                        Tapped="OnThemeCardTapped" CornerRadius="12" Padding="14,10" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                            <Grid x:Name="ThemeLightIconGrid" Width="24" Height="24">
                                                <Ellipse Width="8" Height="8" Stroke="#64748B" StrokeThickness="2"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Line X1="12" Y1="2" X2="12" Y2="4" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="12" Y1="20" X2="12" Y2="22" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="4.22" Y1="4.22" X2="5.64" Y2="5.64" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="18.36" Y1="18.36" X2="19.78" Y2="19.78" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="2" Y1="12" X2="4" Y2="12" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="20" Y1="12" X2="22" Y2="12" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="4.22" Y1="19.78" X2="5.64" Y2="18.36" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                                <Line X1="18.36" Y1="5.64" X2="19.78" Y2="4.22" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="ThemeLightText" Text="Light" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" x:Name="ThemeDarkBorder" Tag="dark"
                                        Tapped="OnThemeCardTapped" CornerRadius="12" Padding="14,10" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                            <Grid x:Name="ThemeDarkIconGrid" Width="24" Height="24">
                                                <Path Data="M21,12.79 A9,9 0 1,1 11.21,3 A7,7 0 0,0 21,12.79 Z"
                                                      Stroke="#64748B" StrokeThickness="2" StrokeLineJoin="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="ThemeDarkText" Text="Dark" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── SimBrief Integration ── -->
                    <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="20">
                        <StackPanel Spacing="16">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                <TextBlock Text="SimBrief Integration" FontFamily="{StaticResource DisplayFontBold}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Border>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="SimBrief Username or ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <!-- Reads live state, not a load-time snapshot: Task 2's ACARS sync
                                         flow can populate SimBriefUsername and flip _isVerified well
                                         after this page has already loaded. -->
                                    <TextBlock x:Name="SimBriefSyncedHintText" Text="· synced from account"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Visibility="Collapsed" />
                                </StackPanel>
                                <Border Background="#0C111D" BorderBrush="#14FFFFFF" BorderThickness="1.5" CornerRadius="12">
                                    <TextBox x:Name="SimBriefUsernameTextBox" PlaceholderText="Username or numeric pilot ID"
                                             Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                             Padding="14,10" TextChanged="OnSimBriefUsernameTextChanged" />
                                </Border>
                            </StackPanel>
                            <Border Background="#121A2A" CornerRadius="12" Padding="13,10">
                                <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="Accepts your SimBrief username (e.g. " />
                                    <Run Text="jsmith" FontWeight="Bold" />
                                    <Run Text=") or numeric pilot ID. You can override this — your account value is only applied on first sync." />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ── Right column ──
                     Task 2 builds ACARS Configuration and Friend Code here. Task 3 adds Hoppies
                     ACARS and App Preferences. Task 4 adds Dispatch Radio. Task 5 adds About &amp;
                     Updates and EFB Companion. Left empty on purpose for this task so the build
                     stays green with a structurally-present-but-empty column. -->
                <Border Grid.Column="1" x:Name="RightColumnPanel" />

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
